# Example only — copy to backend/.env for local use. Never commit real secrets.
# Tracked intentionally via the narrow .gitignore exception below.

# Deployment mode: development, staging or production.
ANPFUEL_ENV=development
# Log level: debug, info, warn or error.
ANPFUEL_LOG_LEVEL=info
# HTTP listen address (host:port).
ANPFUEL_HTTP_ADDR=:8080
# Postgres DSN. Development defaults to the loopback database below when unset;
# staging and production REQUIRE an explicit value and reject this default.
ANPFUEL_DATABASE_URL=postgres://anpfuel:anpfuel@127.0.0.1:5434/anpfuel?sslmode=disable
# Maximum accepted request body, in bytes (positive integer).
ANPFUEL_MAX_BODY_BYTES=1048576
# Graceful shutdown drain window (positive Go duration).
ANPFUEL_SHUTDOWN_TIMEOUT=10s
# Pagination cursor HMAC secret (at least 32 bytes when set; never commit a
# real one). Unset means a per-boot key: single-instance default whose
# cursors invalidate on restart; multi-instance production must share one.
# ANPFUEL_CURSOR_SECRET=change-me-to-32-plus-random-bytes
# Private object storage (S3-compatible, e.g. R2). All-or-nothing: any one
# set requires endpoint, bucket and both key parts. Unset disables upload
# issuance (503) without affecting other routes. Never commit real keys.
# ANPFUEL_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ANPFUEL_R2_BUCKET=anpfuel-quarantine
# ANPFUEL_R2_REGION=auto
# ANPFUEL_R2_ACCESS_KEY_ID=change-me
# ANPFUEL_R2_SECRET_ACCESS_KEY=change-me-to-a-long-random-secret
