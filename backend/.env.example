# Example only — copy to backend/.env for local use. Never commit real secrets.
# Tracked intentionally via the narrow .gitignore exception below.

# Deployment mode: development, staging or production.
ANPFUEL_ENV=development
# Log level: debug, info, warn or error.
ANPFUEL_LOG_LEVEL=info
# HTTP listen address (host:port).
ANPFUEL_HTTP_ADDR=:8080
# Postgres DSN. Development defaults to the loopback database below when unset;
# staging and production REQUIRE an explicit value and reject this default.
ANPFUEL_DATABASE_URL=postgres://anpfuel:anpfuel@127.0.0.1:5432/anpfuel?sslmode=disable
# Maximum accepted request body, in bytes (positive integer).
ANPFUEL_MAX_BODY_BYTES=1048576
# Graceful shutdown drain window (positive Go duration).
ANPFUEL_SHUTDOWN_TIMEOUT=10s
