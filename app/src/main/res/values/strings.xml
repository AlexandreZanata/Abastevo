    <string name="help_screen_title">Help and community rules</string>
    <string name="help_contribute_title">Contribute well</string>
    <string name="help_contribute_body">Photograph price panels only from safe public spots and keep totals legible. Pick the exact price condition. Never invent prices, stations or people.</string>
    <string name="help_rules_title">Community rules</string>
    <string name="help_rules_body">Prices are validated by contributor consensus; dated ANP data is never mixed with live reports. Payment never buys trust, ranking or placement.</string>
    <string name="help_report_title">Report and appeal</string>
    <string name="help_report_body">Any active account can report abuse. Reports never delete content by themselves; restricted moderators review every case. Disagree? Report again with the new reason — appeals reopen as a new reviewed case.</string>
    <string name="help_privacy_title">Privacy</string>
    <string name="help_privacy_body">Anonymous browsing needs no account and coordinates are not stored. Photos are transient audit evidence kept for up to 24 hours.</string>
    <string name="profile_tool_week_picker_title">Survey week</string>
    <string name="profile_tool_week_picker_subtitle">Select archived weekly ANP surveys</string>
    <string name="profile_privacy_section">Privacy and participation</string>
    <string name="profile_privacy_body">No precise GPS is shared publicly. Verification photos expire across all copies within 24 hours. Paid features never affect ranking or trust.</string>

