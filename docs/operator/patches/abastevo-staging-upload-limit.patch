--- abastevo-temp.nginx.conf
+++ abastevo-temp.nginx.conf
@@ -43,0 +44,13 @@
+    # Photo transfers alone use the backend's bounded 3 MiB contract.
+    # Other Abastevo routes retain the existing edge and handler limits.
+    location ~ ^/(v1/uploads/[^/]+/bytes$|abastevo-dev-photos/(q|f)/) {
+        client_max_body_size 3m;
+        proxy_pass http://abastevo_temp_api;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 60s;
+    }
+
