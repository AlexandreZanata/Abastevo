# Staging environment template (P08-T01). Copy to an operator-owned
# path OUTSIDE the repository and fill real values; never commit the
# filled file. Names and constraints only below: every secret-shaped
# value is an obviously-fake REPLACE_ME placeholder.
#
# Usage:
#   cp infra/env.staging.example /srv/anpfuel/staging.env
#   $EDITOR /srv/anpfuel/staging.env
#   ANPFUEL_ENV_FILE=/srv/anpfuel/staging.env \
#   ANPFUEL_RELEASE=2026.09.30-p08t01 \
#   docker compose -f infra/compose.staging.yml config

# Release: immutable image tag built from a reviewed commit (never latest).
ANPFUEL_RELEASE=REPLACE_ME_WITH_IMMUTABLE_TAG

# Database DSN toward the staging db service (credentials from
# ANPFUEL_DB_* below; dev defaults and loopback dev URLs are refused
# by the infra gate). Must be explicit: staging refuses dev defaults.
ANPFUEL_DATABASE_URL=postgres://REPLACE_ME_DB_USER:REPLACE_ME_DB_PASSWORD@db:5432/REPLACE_ME_DB_NAME?sslmode=disable
ANPFUEL_DB_USER=REPLACE_ME_DB_USER
ANPFUEL_DB_NAME=REPLACE_ME_DB_NAME
ANPFUEL_DB_PASSWORD=REPLACE_ME_DB_PASSWORD

# Canonical public authority, exactly the Caddy domain below: request
# proofs cover this host and proxy hosts are never trusted.
ANPFUEL_CANONICAL_HOST=REPLACE_ME_STAGING_DOMAIN

# Cursor secret: at least 32 bytes of randomness, shared by every API
# replica. Generate once per environment, e.g.:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ANPFUEL_CURSOR_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Request limits (bytes / shutdown drain).
ANPFUEL_MAX_BODY_BYTES=1048576
ANPFUEL_SHUTDOWN_TIMEOUT=10s
ANPFUEL_LOG_LEVEL=info

# Private object storage identity (staging bucket/prefix, least
# privilege). Leave unset only if the environment runs without media.
ANPFUEL_R2_ENDPOINT=REPLACE_ME_R2_ENDPOINT
ANPFUEL_R2_BUCKET=REPLACE_ME_STAGING_BUCKET
ANPFUEL_R2_REGION=auto
ANPFUEL_R2_ACCESS_KEY_ID=REPLACE_ME_R2_ACCESS_KEY
ANPFUEL_R2_SECRET_ACCESS_KEY=REPLACE_ME_R2_SECRET

# Edge: must match ANPFUEL_CANONICAL_HOST above.
CADDY_DOMAIN=REPLACE_ME_STAGING_DOMAIN
CADDY_TLS_EMAIL=REPLACE_ME_OPERATOR_EMAIL
