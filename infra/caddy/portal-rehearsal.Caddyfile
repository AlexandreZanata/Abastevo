# Isolated static-portal rehearsal only. No API proxy, no shared edge,
# no production TLS/DNS and no repository credentials. The publisher
# switches /srv/portal/current atomically between verified releases.
{
	admin off
}

:80 {
	root * /srv/portal/current

	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		X-Robots-Tag "noindex, nofollow"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@documents path /consultar/ /consultar/* /precos/ /precos/* /postos/* /fiscalizacao/ /fiscalizacao/* /curiosidades/ /curiosidades/* /dados/ /dados/* /metodologia/
	header @documents Cache-Control "public, max-age=0, must-revalidate"

	file_server {
		precompressed
	}

	handle_errors {
		respond "Página não encontrada" 404
	}
}
