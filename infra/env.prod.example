# Production environment template (P08-T01). Copy to an operator-owned
# path OUTSIDE the repository and fill real values; never commit the
# filled file. Provisioning production data flow additionally requires
# G09 certification: committing this template authorizes nothing.
#
# Usage:
#   cp infra/env.prod.example /srv/anpfuel/prod.env
#   $EDITOR /srv/anpfuel/prod.env
#   ANPFUEL_ENV_FILE=/srv/anpfuel/prod.env \
#   ANPFUEL_RELEASE=<immutable tag> \
#   docker compose -f infra/compose.prod.yml config

# Release: immutable image tag built from the G09 candidate commit (never latest).
ANPFUEL_RELEASE=REPLACE_ME_WITH_IMMUTABLE_TAG

# Database DSN toward the production db service. Dev defaults and
# loopback dev URLs are refused by the infra gate.
ANPFUEL_DATABASE_URL=postgres://REPLACE_ME_DB_USER:REPLACE_ME_DB_PASSWORD@db:5432/REPLACE_ME_DB_NAME?sslmode=disable
ANPFUEL_DB_USER=REPLACE_ME_DB_USER
ANPFUEL_DB_NAME=REPLACE_ME_DB_NAME
ANPFUEL_DB_PASSWORD=REPLACE_ME_DB_PASSWORD

# Canonical public authority, exactly the Caddy domain below.
ANPFUEL_CANONICAL_HOST=REPLACE_ME_PROD_DOMAIN

# Cursor secret: at least 32 bytes of randomness, unique per
# environment (never shared with staging).
ANPFUEL_CURSOR_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

ANPFUEL_MAX_BODY_BYTES=1048576
ANPFUEL_SHUTDOWN_TIMEOUT=10s
ANPFUEL_LOG_LEVEL=warn

# Private object storage identity (production bucket/prefix, least
# privilege, credentials separate from staging).
ANPFUEL_R2_ENDPOINT=REPLACE_ME_R2_ENDPOINT
ANPFUEL_R2_BUCKET=REPLACE_ME_PROD_BUCKET
ANPFUEL_R2_REGION=auto
ANPFUEL_R2_ACCESS_KEY_ID=REPLACE_ME_R2_ACCESS_KEY
ANPFUEL_R2_SECRET_ACCESS_KEY=REPLACE_ME_R2_SECRET

# Edge: must match ANPFUEL_CANONICAL_HOST above.
CADDY_DOMAIN=REPLACE_ME_PROD_DOMAIN
CADDY_TLS_EMAIL=REPLACE_ME_OPERATOR_EMAIL
