    "enterprise.queue.offline_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline records are saved on this device and sent later. Signing out deletes these records from this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão, os registros ficam guardados neste aparelho e são enviados depois. Sair da conta apaga estes registros do aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión, los registros se guardan en este dispositivo y se envían más tarde. Al cerrar sesión, se eliminan del dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Datensätze werden auf diesem Gerät gespeichert und später gesendet. Bei der Abmeldung werden sie von diesem Gerät gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors connexion, les données sont conservées sur cet appareil et envoyées plus tard. La déconnexion supprime ces données de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインの記録はこのデバイスに保存され、後で送信されます。サインアウトすると、このデバイスから削除されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без интернета записи хранятся на устройстве и отправляются позже. При выходе из аккаунта они удаляются с устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线时，记录保存在此设备上并稍后发送。退出登录会从此设备删除这些记录。"
          }
        }
      }
    },
