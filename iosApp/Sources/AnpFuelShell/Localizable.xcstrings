    "ledger.gaps_effect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These markers stay on this device and make consumption unavailable for the affected period."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas marcações ficam neste aparelho e tornam indisponível o consumo do período afetado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas marcas se guardan en este dispositivo y dejan el consumo del período afectado sin datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Markierungen bleiben auf diesem Gerät. Für den betroffenen Zeitraum ist kein Verbrauch verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces marques restent sur cet appareil. La consommation est indisponible pour la période concernée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのマークはこの端末に保存され、対象期間の消費量は表示されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти отметки сохраняются на устройстве. Расход за затронутый период недоступен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些标记保存在此设备上。受影响期间的能耗数据不可用。"
          }
        }
      }
    },
    "ledger.metrics.basis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible distance: %1$@ · calculation v%2$@. Based on purchases rather than fuel inventory. Missing entries affect the result."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distância elegível: %1$@ · cálculo v%2$@. Estimativas de compra, não medição de estoque; lançamentos esquecidos alteram o resultado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distancia válida: %1$@ · cálculo v%2$@. Se basa en compras, no en existencias. Los registros faltantes afectan al resultado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrechenbare Strecke: %1$@ · Berechnung v%2$@. Grundlage sind Käufe, keine Bestandsmessung. Fehlende Einträge beeinflussen das Ergebnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance admissible : %1$@ · calcul v%2$@. Estimation fondée sur les achats, sans mesure du stock. Les écritures manquantes influent sur le résultat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象距離：%1$@ · 計算 v%2$@。燃料残量の測定値ではなく購入記録に基づきます。未記録の項目は結果に影響します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
