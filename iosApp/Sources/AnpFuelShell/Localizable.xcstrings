          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zum Veröffentlichen mit deinem kostenlosen Konto an. Bis dahin bleibt der Entwurf auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre compte gratuit pour publier. En attendant, le brouillon reste sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するには無料アカウントにサインインしてください。それまでは下書きがこの端末に保存されます。"
