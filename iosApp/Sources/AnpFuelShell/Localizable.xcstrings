    "ledger.conflict.keep_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your version submits a new change based on the current revision. Changes are not resolved by arrival order."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a sua versão envia uma nova alteração sobre a revisão atual. Nada é decidido pela ordem de chegada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar tu versión envía un cambio nuevo sobre la revisión actual. El orden de llegada no resuelve el conflicto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deine Version behältst, wird eine neue Änderung auf Basis der aktuellen Revision gesendet. Die Eingangsreihenfolge entscheidet nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver votre version envoie une modification basée sur la révision actuelle. L’ordre d’arrivée ne résout pas le conflit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のバージョンを保持すると、現在のリビジョンに基づく新しい変更を送信します。到着順で競合を解決することはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша версия отправляется как новое изменение на основе текущей ревизии. Порядок поступления не определяет исход."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留您的版本会基于当前修订提交新更改。冲突不会按到达顺序处理。"
          }
        }
      }
    },
