    "onboarding.photo_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted photos expire on this device after 24 hours and are excluded from cloud backups."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos enviadas expiram localmente em 24 horas e nunca vão para backup em nuvem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos enviadas caducan en este dispositivo a las 24 horas y quedan fuera de las copias en la nube."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendete Fotos laufen auf dem Gerät nach 24 Stunden ab und sind von Cloud-Backups ausgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos envoyées expirent sur cet appareil après 24 heures et sont exclues des sauvegardes dans le cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信した写真は端末上で24時間後に期限切れとなり、クラウドバックアップの対象外です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленные фото удаляются с устройства через 24 часа и не попадают в облачные резервные копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交的照片在此设备上保留 24 小时，不纳入云备份。"
          }
        }
      }
    },
