    "android.capture_conditional_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo may show a restricted price. Report only the default price available without a special payment method, app or membership."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto pode mostrar um preço com restrições. Informe apenas o preço padrão disponível sem exigir forma de pagamento, aplicativo ou cadastro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto puede mostrar un precio restringido. Informa solo del precio normal disponible sin exigir una forma de pago, aplicación o registro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto kann einen Preis mit Bedingungen zeigen. Melde nur den regulären Preis, der ohne bestimmte Zahlungsart, App oder Registrierung verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo peut afficher un prix sous conditions. Indiquez uniquement le prix habituel disponible sans mode de paiement, application ou inscription imposés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真には条件付きの価格が含まれる可能性があります。特定の支払方法、アプリ、登録を必要としない通常価格のみを報告してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На фото может быть цена с особыми условиями. Указывайте только обычную цену, доступную без обязательного способа оплаты, приложения или регистрации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此照片可能显示有条件的价格。请仅报告不要求特定付款方式、应用或注册的普通价格。"
          }
        }
      },
      "comment": "Android resource: capture_conditional_warning"
    },
