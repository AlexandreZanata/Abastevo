    "explore.faq.payment_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments never affect price order or trust in stations or users."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamentos nunca alteram a ordem dos preços nem a confiança em postos ou usuários."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos nunca afectan al orden de precios ni a la confianza en las estaciones o los usuarios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen haben keinen Einfluss auf die Preissortierung oder die Vertrauenswürdigkeit von Tankstellen und Nutzern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements n’influencent jamais le classement par prix ni la confiance accordée aux stations ou utilisateurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いによって価格の並び順や給油所・ユーザーの信頼度が変わることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата никогда не влияет на порядок цен и доверие к АЗС или пользователям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款不会影响价格排序，也不会改变对加油站或用户的信任度。"
          }
        }
      }
    },
    "explore.faq.payment_question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can stations pay for better placement?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O abastevo aceita pagamento para destacar postos?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pueden las estaciones pagar por aparecer destacadas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Können Tankstellen für eine bessere Platzierung bezahlen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stations peuvent-elles payer pour être mises en avant ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給油所は料金を支払って優先表示してもらえますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Могут ли АЗС заплатить за более заметное место?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加油站可以付费获得更高的展示位置吗？"
          }
        }
      }
    },
    "explore.faq.photos_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this device, compressed JPEG photos expire after 24 hours and are excluded from automatic backups."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste aparelho, as fotos comprimidas em JPEG expiram após 24 horas e ficam fora do backup automático."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este dispositivo, las fotos JPEG comprimidas caducan después de 24 horas y quedan fuera de las copias de seguridad automáticas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät laufen komprimierte JPEG-Fotos nach 24 Stunden ab und werden von automatischen Backups ausgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet appareil, les photos JPEG compressées expirent après 24 heures et sont exclues des sauvegardes automatiques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の圧縮JPEG写真は24時間後に期限切れとなり、自動バックアップから除外されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве срок хранения сжатых фотографий JPEG составляет 24 часа. Они не включаются в автоматические резервные копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的压缩 JPEG 照片在 24 小时后过期，且不会包含在自动备份中。"
          }
        }
      }
    },
