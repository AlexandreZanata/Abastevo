    "android.terms_gate_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read and accept the Terms of Use and declare that I have read the Privacy Policy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Li e aceito os Termos de Uso e declaro que li a Política de Privacidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído y acepto los Términos de Uso y declaro que he leído la Política de Privacidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Nutzungsbedingungen gelesen und akzeptiere sie und erkläre, die Datenschutzerklärung gelesen zu haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai lu et j'accepte les Conditions d'utilisation et je déclare avoir lu la Politique de confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約を読んで同意し、プライバシーポリシーを読んだことを確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал(а) и принимаю Условия использования и подтверждаю, что прочитал(а) Политику конфиденциальности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读并接受《使用条款》,并声明已阅读《隐私政策》。"
          }
        }
      },
      "comment": "Android resource: terms_gate_check"
    },
    "android.terms_gate_optional_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This acceptance does not authorize the optional use of photos for training. That choice is separate and lives in Privacy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aceite não autoriza o uso opcional de fotos para treinamento. Essa escolha é separada e fica em Privacidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aceptación no autoriza el uso opcional de fotos para entrenamiento. Esa elección es independiente y está en Privacidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zustimmung erlaubt nicht die optionale Nutzung von Fotos für das Training. Diese Wahl ist getrennt und steht unter Datenschutz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette acceptation n'autorise pas l'usage facultatif des photos pour l'entraînement. Ce choix est distinct et se trouve dans Confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この同意は、学習のための写真の任意利用を許可するものではありません。その選択は別で、「プライバシー」にあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это согласие не разрешает необязательное использование фото для обучения. Этот выбор делается отдельно в разделе «Конфиденциальность»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此接受并不授权将照片用于训练的可选用途。该选择是独立的,位于“隐私”中。"
          }
        }
      },
      "comment": "Android resource: terms_gate_optional_note"
    },
