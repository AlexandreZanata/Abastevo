    "android.community_confidence_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community support, not a guarantee. ANP is an official survey, not a live pump price."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoio da comunidade, não garantia. ANP é pesquisa oficial, não preço vivo na bomba."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyo de la comunidad, no garantía. ANP es una encuesta oficial, no el precio en vivo del surtidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Community-Unterstützung, keine Garantie. ANP ist eine offizielle Erhebung, kein Live-Zapfsäulenpreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutien de la communauté, pas une garantie. L'ANP est une enquête officielle, pas un prix en direct à la pompe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティの支持であり、保証ではありません。ANP は公式調査であり、店頭のリアルタイム価格ではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка сообщества, а не гарантия. ANP — официальный обзор, а не живая цена на колонке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区支持，而非保证。ANP 是官方调查，不是加油站实时价格。"
          }
        }
      },
      "comment": "Android resource: community_confidence_note"
    },
