    "help.device_ocr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribute by photographing the station’s price board. Text recognition runs on your iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribua fotografando a placa de preços do posto. O reconhecimento roda no iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colabora fotografiando el cartel de precios de la estación. El reconocimiento se realiza en tu iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere eine Preistafel, um beizutragen. Die Texterkennung findet auf deinem iPhone statt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuez en photographiant le panneau des prix de la station. La reconnaissance s’effectue sur votre iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給油所の価格表示板を撮影して投稿できます。文字認識はiPhone上で行われます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы внести вклад, сфотографируйте табло цен АЗС. Текст распознаётся на iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄加油站价格牌即可贡献。文字识别在你的 iPhone 上完成。"
          }
        }
      }
    },
    "help.no_paid_ranking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment never affects rankings or trust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento nunca afeta o ranking ou a confiança."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago nunca influye en las clasificaciones ni en la confianza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen beeinflussen nie die Rangfolge oder das Vertrauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements n’affectent ni le classement ni la confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いが順位や信頼性に影響を与えることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата не влияет на рейтинг или доверие."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款不会影响排名或信任度。"
          }
        }
      }
    },
