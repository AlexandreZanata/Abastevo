    "enterprise.queue.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many records are waiting to be sent. Connect to send them before creating more."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos registros aguardando envio. Conecte-se para enviá-los antes de criar outros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados registros pendientes. Conéctate para enviarlos antes de crear más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Datensätze warten auf den Versand. Stelle eine Verbindung her und sende sie, bevor du weitere erstellst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’enregistrements attendent l’envoi. Connectez-vous pour les envoyer avant d’en créer d’autres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ちの記録が多すぎます。新しく作成する前に、インターネットに接続して送信してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много записей ожидают отправки. Подключитесь к интернету и отправьте их перед созданием новых."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待发送的记录过多。请联网发送后再创建新记录。"
          }
        }
      }
    },
