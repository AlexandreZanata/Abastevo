        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura final del odómetro debe ser igual o superior a la inicial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der abschließende Kilometerstand muss mindestens dem Startwert entsprechen."
