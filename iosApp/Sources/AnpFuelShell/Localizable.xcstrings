        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the limit of blocked users. Unblock someone in Profile → Manage account → Blocked users first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de usuários bloqueados. Desbloqueie alguém em Perfil → Gerenciar conta → Usuários bloqueados antes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanzaste el límite de usuarios bloqueados. Primero desbloquea a alguien en Perfil → Gestionar cuenta → Usuarios bloqueados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Höchstzahl blockierter Nutzer erreicht. Gib zuerst jemanden unter Profil → Konto verwalten → Blockierte Nutzer frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint la limite d’utilisateurs bloqués. Débloquez d’abord quelqu’un dans Profil → Gérer le compte → Utilisateurs bloqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックできるユーザー数の上限に達しました。先に「プロフィール → アカウントを管理 → ブロックしたユーザー」で誰かのブロックを解除してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит заблокированных пользователей. Сначала разблокируйте кого-нибудь в разделе «Профиль → Управлять аккаунтом → Заблокированные пользователи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽的用户数量已达上限。请先在“个人资料 → 管理账户 → 已屏蔽的用户”中解除对某人的屏蔽。"
          }
        }
      },
      "comment": "Android resource: safety_error_block_limit"
    },
    "android.safety_error_generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action could not be completed. Try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a ação. Tente novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la acción. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion konnte nicht abgeschlossen werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action n’a pas pu aboutir. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить действие. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成该操作，请重试。"
          }
        }
      },
      "comment": "Android resource: safety_error_generic"
    },
