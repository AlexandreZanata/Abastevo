    "android.training_consent_regrant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms changed since your last review — please review and confirm again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os termos mudaram desde sua última análise — leia e confirme novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las condiciones han cambiado desde tu última revisión — léelas y confirma de nuevo."
