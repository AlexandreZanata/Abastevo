        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads paused: the server requires Premium (professional.write) or consent. Your entries remain here, and deleting is still free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envios pausados: o servidor exige o Premium (professional.write) ou o consentimento. Os registros continuam aqui, e exclusões seguem gratuitas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
