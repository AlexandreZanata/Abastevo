    },
    "android.enterprise_invitation_consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to join this company and share the data described above."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceito participar desta empresa e compartilhar os dados descritos acima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto unirme a esta empresa y compartir los datos descritos arriba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme dem Beitritt zu diesem Unternehmen und der Freigabe der oben beschriebenen Daten zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
