    "enterprise.checklist.photo_contact_fleet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A problem with one item requires a photo. iOS cannot send it yet. Contact your fleet manager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item com problema exige foto, que ainda não pode ser enviada pelo iOS. Fale com o gestor da frota."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento con problemas requiere una foto. iOS aún no puede enviarla. Ponte en contacto con el responsable de flota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein problematischer Punkt erfordert ein Foto. iOS kann es noch nicht senden. Wende dich an die Fuhrparkleitung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point à problème nécessite une photo. iOS ne peut pas encore l’envoyer. Contactez le gestionnaire de flotte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題のある項目には写真が必要ですが、iOS ではまだ送信できません。車両管理者に連絡してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проблемный пункт требует фото. iOS пока не может его отправить. Свяжитесь с менеджером автопарка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有问题的项目需要照片，iOS 暂不支持发送。请联系车队管理员。"
          }
        }
      }
    },
