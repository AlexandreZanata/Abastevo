    "map.offline.region_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "abastevo map packages use the Android map engine. On iOS, use the offline maps you downloaded in Apple Maps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes de mapa do abastevo usam o motor de mapas do Android. No iOS, use os mapas offline que você baixou no Apple Maps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes de mapas de abastevo usan el motor de Android. En iOS, usa los mapas sin conexión que descargaste en Apple Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kartenpakete von abastevo verwenden die Android-Kartenengine. Nutze unter iOS die in Apple Karten geladenen Offlinekarten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs de cartes d’abastevo utilisent le moteur cartographique d’Android. Sur iOS, utilisez les plans hors ligne téléchargés dans Apple Plans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "abastevoのマップパッケージはAndroidの地図エンジンを使用します。iOSではAppleマップでダウンロードしたオフラインマップを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакеты карт abastevo используют движок Android. В iOS пользуйтесь офлайн-картами, скачанными в Картах Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "abastevo 地图包使用 Android 地图引擎。在 iOS 上，请使用在 Apple 地图中下载的离线地图。"
          }
        }
      }
    },
