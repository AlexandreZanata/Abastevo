        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedingungen haben sich seit Ihrer letzten Prüfung geändert — bitte erneut lesen und bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conditions ont changé depuis votre dernière lecture — consultez-les et confirmez à nouveau."
