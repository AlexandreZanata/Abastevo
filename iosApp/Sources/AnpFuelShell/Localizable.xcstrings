            "value": "你处于离线状态，请联网后重试。"
          }
        }
      },
      "comment": "Android resource: safety_error_offline"
    },
    "android.safety_error_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again in %1$lld seconds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
