    "android.station_claim_refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access refused. The account or its authority may have changed. Refresh and authenticate again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso recusado. A conta ou sua autoridade pode ter mudado. Atualize e autentique-se novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso rechazado. La cuenta o los poderes pueden haber cambiado. Actualiza y autentícate de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert. Konto oder Befugnis können geändert sein. Aktualisieren und erneut anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé. Le compte ou les pouvoirs ont pu changer. Actualisez et reconnectez-vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが拒否されました。アカウントまたは権限が変更された可能性があります。更新して再認証してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
