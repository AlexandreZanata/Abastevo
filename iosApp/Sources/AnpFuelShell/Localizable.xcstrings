          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を確認してください。サービスは一覧から選択、説明は280文字まで、その他はUTF-8で256バイトまでです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте поля: услуги из списка, описание до 280 символов, остальные поля до 256 байт UTF-8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查字段：服务须从列表选择，描述最多280字，其他字段最多256个UTF-8字节。"
