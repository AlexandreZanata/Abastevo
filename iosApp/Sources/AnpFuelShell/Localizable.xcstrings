    "community.comment_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your free account to publish. Until then, the draft stays on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na conta gratuita para publicar. Até lá, o texto fica como rascunho neste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
