    "premium.store_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud backup and sync, advanced alerts, professional tools and additional vehicles. Your Apple Account is charged, and it renews automatically unless canceled in Settings at least 24 hours before the end of the period."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup e sincronização na nuvem, alertas avançados, ferramentas profissionais e veículos adicionais. A cobrança é feita na sua conta Apple e renova automaticamente até ser cancelada nos Ajustes, pelo menos 24 horas antes do fim do período."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia y sincronización en la nube, alertas avanzadas, herramientas profesionales y vehículos adicionales. El cargo se realiza en tu cuenta de Apple y se renueva automáticamente si no cancelas en Ajustes al menos 24 horas antes del final del período."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Backup und -Synchronisierung, erweiterte Meldungen, professionelle Werkzeuge und zusätzliche Fahrzeuge. Die Abrechnung erfolgt über deinen Apple Account. Das Abonnement verlängert sich automatisch, sofern du es nicht mindestens 24 Stunden vor Ablauf in den Einstellungen kündigst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde et synchronisation cloud, alertes avancées, outils professionnels et véhicules supplémentaires. Le paiement est débité de votre compte Apple. L’abonnement se renouvelle automatiquement sauf résiliation dans Réglages au moins 24 heures avant la fin de la période."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドバックアップと同期、高度なアラート、業務用ツール、車両の追加を利用できます。Apple Accountに請求され、期間終了の24時間以上前に設定で解約しない限り自動更新されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачное резервное копирование и синхронизация, расширенные уведомления, профессиональные инструменты и дополнительные автомобили. Оплата списывается с аккаунта Apple. Подписка продлевается автоматически, если не отменить её в настройках не позднее чем за 24 часа до конца периода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括云备份与同步、高级提醒、专业工具及额外车辆。费用将从你的 Apple 账号扣除，除非在当前周期结束前至少 24 小时在设置中取消，否则会自动续订。"
          }
        }
      }
    },
