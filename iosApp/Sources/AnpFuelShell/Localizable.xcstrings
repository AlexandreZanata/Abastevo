    "android.station_management_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service unavailable. No success confirmed. Check the discussion before attempting another reply."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço indisponível. Nenhum sucesso confirmado. Consulte a conversa antes de tentar outra resposta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio no disponible. Éxito no confirmado. Consulta la conversación antes de intentar otra respuesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienst nicht verfügbar. Erfolg nicht bestätigt. Diskussion vor einer weiteren Antwort prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service indisponible. Aucun succès confirmé. Consultez la discussion avant de réessayer une réponse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスを利用できません。成功は未確認です。別の返信を試す前に会話を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис недоступен. Успех не подтверждён. Проверьте обсуждение перед повторным ответом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务不可用，尚未确认成功。再次回复前请查看讨论。"
          }
        }
      },
      "comment": "Android resource: station_management_unavailable"
    },
