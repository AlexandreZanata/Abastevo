    "android.enterprise_context_ownership": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay with the company where they were created when you switch workspaces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros continuam na empresa em que foram criados ao trocar de espaço."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar de espacio, los registros permanecen en la empresa donde se crearon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Bereichswechsel bleiben Einträge in dem Unternehmen, in dem sie erstellt wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors d’un changement d’espace, les enregistrements restent dans l’entreprise où ils ont été créés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを切り替えても、記録は作成元の企業に残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене пространства записи остаются в той компании, где они были созданы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换空间时，记录仍保留在创建它们的企业中。"
          }
        }
      },
      "comment": "Android resource: enterprise_context_ownership"
    },
