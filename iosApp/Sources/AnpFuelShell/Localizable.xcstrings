          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas répondu. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeから応答がありません。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не ответил. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无响应。请重试。"
          }
        }
      }
    },
    "premium.ask_to_buy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase awaiting approval (Ask to Buy). Premium activates after the App Store confirms it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra aguardando aprovação (Pedir para Comprar). O Premium ativa quando a App Store confirmar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra pendiente de aprobación (Solicitar la compra). Premium se activará cuando la App Store la confirme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf wartet auf Freigabe (Kaufanfrage). Premium wird nach Bestätigung durch den App Store aktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat en attente d’approbation (Demander l’autorisation d’achat). Premium s’active après confirmation par l’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです（承認と購入のリクエスト）。App Storeの承認後にPremiumが有効になります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения (Запрос на покупку). Premium активируется после подтверждения App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准（购买前询问）。App Store 确认后将激活 Premium。"
          }
        }
      }
    },
    "premium.cancel_and_delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canceling Premium keeps your data. If you delete your account, cancel the subscription here to stop App Store billing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar o Premium não apaga seus dados. Excluir a conta não cancela a cobrança da App Store: cancele a assinatura aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar Premium conserva tus datos. Si eliminas tu cuenta, cancela aquí la suscripción para detener la facturación de la App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Premium kündigst, bleiben deine Daten erhalten. Beende das Abonnement hier, wenn du dein Konto löschst, um die Abrechnung über den App Store zu stoppen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation de Premium conserve vos données. Si vous supprimez votre compte, résiliez l’abonnement ici pour arrêter la facturation de l’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiumを解約してもデータは保持されます。アカウントを削除する場合は、ここでサブスクリプションを解約してApp Storeの請求を停止してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отмене Premium ваши данные сохранятся. Если вы удаляете учётную запись, отмените подписку здесь, чтобы прекратить списания App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消 Premium 后，你的数据仍会保留。如果删除账号，请在此取消订阅以停止 App Store 扣款。"
          }
        }
      }
    },
