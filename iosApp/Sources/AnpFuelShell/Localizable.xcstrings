    "account.connected_identity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed-in Account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidade Conectada"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta conectada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldetes Konto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte connecté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中のアカウント"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активная учётная запись"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录的账号"
          }
        }
      }
    },
    "account.deletion_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request ends your access. Once the server confirms it, the app clears private account data stored on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação encerra seu acesso. Após a confirmação do servidor, o app limpará os dados privados locais da conta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud pone fin a tu acceso. Cuando el servidor la confirme, la app borrará los datos privados de la cuenta en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Antrag endet dein Zugriff. Sobald der Server ihn bestätigt, löscht die App die privaten Kontodaten auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande met fin à votre accès. Après confirmation du serveur, l’app efface les données privées du compte stockées sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申請するとアクセスできなくなります。サーバーによる確認後、アプリは端末上のアカウントの非公開データを消去します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После запроса доступ прекращается. Когда сервер подтвердит запрос, приложение удалит личные данные учётной записи на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该请求会终止你的访问权限。服务器确认后，应用会清除此设备上存储的账号私密数据。"
          }
        }
      }
    },
