        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出此设备的本地数据（JSON）"
          }
        }
      }
    },
    "account.logout_and_purge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out and clear private local data"
          }
        },
        "pt-BR": {
          "stringUnit": {
