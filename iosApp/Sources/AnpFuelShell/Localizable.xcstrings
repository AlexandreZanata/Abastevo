    "android.station_claim_scopes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested scope: business information and official replies. No authority over community prices or ratings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escopo solicitado: informações comerciais e respostas oficiais. Sem autoridade sobre preços ou avaliações da comunidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos solicitados: información comercial y respuestas oficiales. Sin autoridad sobre precios ni valoraciones comunitarias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantragter Umfang: Geschäftsdaten und offizielle Antworten. Keine Befugnis über Gemeinschaftspreise oder Bewertungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portée demandée : informations commerciales et réponses officielles. Aucun pouvoir sur les prix ou avis communautaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申請範囲は営業情報と公式返信です。コミュニティの価格や評価を管理する権限は含まれません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашиваемые права: коммерческие сведения и официальные ответы. Без полномочий над ценами и оценками сообщества."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请范围：商业信息及官方回复。不包含对社区价格或评价的管理权。"
          }
        }
      },
      "comment": "Android resource: station_claim_scopes"
    },
