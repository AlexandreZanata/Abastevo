    "android.notification_permission_denied_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled. Enable them in system settings to receive price drop alerts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative-as nas configurações do sistema para receber alertas de queda de preço."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívelas en la configuración del sistema para recibir alertas de bajada de precio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind deaktiviert. Aktivieren Sie sie in den Systemeinstellungen, um Preissenkungsalarme zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Activez-les dans les paramètres système pour recevoir des alertes de baisse de prix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が無効です。値下がりアラートを受け取るには、システム設定で通知を有効にしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены. Включите их в системных настройках, чтобы получать оповещения о снижении цены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已禁用。请在系统设置中启用通知以接收降价提醒。"
          }
        }
      },
      "comment": "Android resource: notification_permission_denied_hint"
    },
