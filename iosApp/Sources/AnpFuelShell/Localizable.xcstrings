    },
    "android.safety_error_self_target": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own content. You cannot report or block yourself."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conteúdo é seu. Não é possível denunciar ou bloquear a si mesmo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido es tuyo. No puedes denunciarte ni bloquearte a ti mismo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein eigener Inhalt. Du kannst dich nicht selbst melden oder blockieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu est le vôtre. Vous ne pouvez pas vous signaler ni vous bloquer vous-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた自身のコンテンツです。自分を報告またはブロックすることはできません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваш собственный контент. Нельзя пожаловаться на себя или заблокировать себя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你自己的内容，不能举报或屏蔽自己。"
          }
        }
      },
      "comment": "Android resource: safety_error_self_target"
    },
