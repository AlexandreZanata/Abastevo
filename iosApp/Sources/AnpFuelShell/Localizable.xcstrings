    "android.quality_aspect_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sample assessment considers the fuel and related assays. Assessing the entire station requires more than a single result."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O julgamento da amostra considera o combustível e os ensaios complementares. Um resultado isolado não classifica todo o posto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La evaluación considera el combustible y los ensayos complementarios. Un resultado aislado no clasifica toda la estación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Probenbewertung berücksichtigt Kraftstoff und ergänzende Prüfungen. Ein einzelnes Ergebnis bewertet nicht die gesamte Tankstelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jugement tient compte du carburant et des essais complémentaires. Un résultat isolé ne classe pas toute la station."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試料の判定は燃料と補足検査に基づきます。単独の結果で給油所全体を評価することはできません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка пробы учитывает топливо и дополнительные испытания. Один результат не оценивает всю АЗС."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样品判定会考虑燃料类型及补充检测。单项结果不能代表整个加油站。"
          }
        }
      }
    },
