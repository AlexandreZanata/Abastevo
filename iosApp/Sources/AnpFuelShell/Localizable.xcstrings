      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all advanced alert rules and inbox entries for this account?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar todas as regras avançadas e os registros da caixa de alertas desta conta?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar todas las reglas avanzadas y los registros de la bandeja de esta cuenta?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erweiterten Alarmregeln und Postfacheinträge für dieses Konto löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer toutes les règles avancées et les entrées de la boîte de ce compte ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの詳細ルールと受信箱の記録をすべて消去しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стереть все расширенные правила и входящие оповещения этого аккаунта?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除此账号的所有高级提醒规则和收件箱记录吗？"
          }
        }
      }
    },
