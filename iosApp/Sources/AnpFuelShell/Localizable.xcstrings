    "ledger.sync.pull_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads entries missing on this device and newer versions of entries without local edits. Local entries and pending edits are preserved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz lançamentos da conta que faltam neste aparelho e versões mais novas de registros sem edição pendente. Nada local é apagado ou sobrescrito com edições pendentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga los registros que faltan en este dispositivo y versiones más recientes sin cambios locales. Se conservan los registros y cambios pendientes de este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt auf diesem Gerät fehlende Einträge und neuere Versionen ohne lokale Änderungen. Lokale Einträge und ausstehende Änderungen bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les écritures manquantes et les versions récentes sans modification locale. Les écritures et modifications locales sont préservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にない記録と、ローカル編集がない記録の新しいバージョンをダウンロードします。端末の記録や保留中の編集は保持されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивает отсутствующие записи и новые версии записей без локальных изменений. Локальные записи и ожидающие изменения сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载此设备上缺少的记录，以及没有待处理本地编辑的较新版本。本地记录和待处理编辑会保留。"
          }
        }
      }
    },
