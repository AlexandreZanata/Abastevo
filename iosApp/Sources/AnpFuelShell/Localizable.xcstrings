            "state": "translated",
            "value": "This entry was deleted from the server on another device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não tem mais este registro (excluído em outro aparelho)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro se eliminó del servidor desde otro dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag wurde auf einem anderen Gerät vom Server gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
