    "ledger.sync.revoke_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads are paused on this device. Server consent could not be revoked right now."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envios pausados neste aparelho; o consentimento no servidor não pôde ser revogado agora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pausaron los envíos en este dispositivo. No se pudo retirar ahora el consentimiento en el servidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads sind auf diesem Gerät pausiert. Die Einwilligung konnte auf dem Server derzeit nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois sont suspendus sur cet appareil. Le consentement n’a pas pu être révoqué sur le serveur pour le moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末からのアップロードを一時停止しました。現在はサーバーの同意を取り消せません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка с этого устройства приостановлена. Сейчас не удалось отозвать согласие на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的上传已暂停。目前无法撤回服务器上的同意。"
          }
        }
      }
    },
