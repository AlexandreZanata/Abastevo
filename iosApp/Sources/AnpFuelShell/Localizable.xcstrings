    "ledger.sync.enable_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries to upload to this account: %1$@. Photos and location are excluded. Premium (professional.write) is required. Deleting and exporting are still free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lançamentos a enviar para esta conta: %1$@. Fotos e localização não são incluídas. Exige o Premium (professional.write); exclusão e exportação continuam gratuitas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros para enviar a esta cuenta: %1$@. No se incluyen fotos ni ubicación. Se requiere Premium (professional.write). Eliminar y exportar sigue siendo gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge zum Hochladen in dieses Konto: %1$@. Fotos und Standort bleiben ausgeschlossen. Premium (professional.write) ist erforderlich. Löschen und Export bleiben kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écritures à envoyer à ce compte : %1$@. Les photos et la position ne sont pas incluses. Premium (professional.write) est requis. La suppression et l’export restent gratuits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにアップロードする記録：%1$@件。写真や位置情報は送信されません。プレミアム（professional.write）が必要です。削除とエクスポートは引き続き無料です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей для отправки в аккаунт: %1$@. Фотографии и местоположение не включаются. Требуется Premium (professional.write). Удаление и экспорт остаются бесплатными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将上传至此账户的记录：%1$@ 条。不包含照片或位置信息。需要 Premium（professional.write）。删除和导出仍然免费。"
          }
        }
      }
