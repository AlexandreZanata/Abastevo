    "forum.topic_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your free account to publish. Until then, the topic stays as a draft on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na conta gratuita para publicar. Até lá, o tópico fica como rascunho neste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta gratuita para publicar. Hasta entonces, el tema se guarda como borrador en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zum Veröffentlichen mit deinem kostenlosen Konto an. Bis dahin bleibt das Thema als Entwurf auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre compte gratuit pour publier. En attendant, le sujet reste en brouillon sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿するには無料アカウントにサインインしてください。それまではトピックがこの端末に下書きとして保存されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в бесплатную учётную запись для публикации. До этого черновик темы хранится на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录免费账号后可发布。在此之前，主题将作为草稿保存在此设备上。"
          }
        }
      }
    },
