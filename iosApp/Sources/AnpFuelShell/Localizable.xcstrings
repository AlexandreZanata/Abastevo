    "android.station_management_server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your approved request does not guarantee current access. The server checks the current account, grant and operator on every action."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua solicitação aprovada não garante acesso atual. O servidor verifica a conta, a permissão e o operador em cada ação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud aprobada no garantiza acceso actual. El servidor verifica cuenta, permiso y operador en cada acción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein genehmigter Antrag garantiert keinen aktuellen Zugriff. Der Server prüft Konto, Berechtigung und Betreiber bei jeder Aktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande approuvée ne garantit pas l’accès actuel. Le serveur vérifie compte, autorisation et exploitant à chaque action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みの申請は現在のアクセス権を保証しません。サーバーは操作ごとにアカウント、権限、運営者を確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобренная заявка не гарантирует текущий доступ. Сервер проверяет аккаунт, разрешение и оператора при каждом действии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请获批不保证当前访问权限。服务器会逐次核对账户、授权及运营方。"
          }
        }
      },
      "comment": "Android resource: station_management_server"
    },
