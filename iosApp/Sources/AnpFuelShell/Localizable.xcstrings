    },
    "android.station_claim_export_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the exact server declaration as text. Include it unchanged in a PDF and sign using your external signing tool. Return here to select the signed PDF. A new declaration invalidates the previous one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve a declaração exata do servidor em texto. Inclua-a sem alterações em um PDF e assine com sua ferramenta externa de assinatura. Volte aqui para selecionar o PDF assinado. Uma nova declaração invalida a anterior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la declaración exacta del servidor como texto. Inclúyela sin cambios en un PDF y firma con tu herramienta externa. Vuelve para seleccionar el PDF firmado. Una declaración nueva invalida la anterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakte Servererklärung als Text speichern. Unverändert in ein PDF aufnehmen und mit externem Werkzeug signieren. Danach signiertes PDF hier auswählen. Eine neue Erklärung ersetzt die vorherige."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez la déclaration exacte du serveur en texte. Incluez-la sans modification dans un PDF et signez avec un outil externe. Revenez sélectionner le PDF signé. Une nouvelle déclaration invalide l’ancienne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの申告文をそのままテキストで保存してください。変更せずにPDFに含め、外部ツールで署名してから、ここで署名済みPDFを選択します。新しい申告文は以前のものを無効にします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните точный текст заявления сервера. Включите его без изменений в PDF и подпишите внешним инструментом. Вернитесь и выберите подписанный PDF. Новое заявление отменяет предыдущее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将服务器原始声明保存为文本，原样放入PDF并使用外部工具签名，再返回选择已签名PDF。新声明会使旧声明失效。"
          }
        }
      },
      "comment": "Android resource: station_claim_export_help"
    },
    "android.station_claim_file_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original PDF loaded. Confirm to send it for independent review."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF original carregado. Confirme para enviá-lo para análise independente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF original cargado. Confirma el envío para revisión independiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original-PDF geladen. Für unabhängige Prüfung Versand bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF original chargé. Confirmez l’envoi pour examen indépendant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のPDFを読み込みました。独立審査への送信を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный PDF загружен. Подтвердите отправку на независимую проверку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始PDF已加载。请确认发送以接受独立审核。"
          }
        }
      },
      "comment": "Android resource: station_claim_file_ready"
    },
    "android.station_claim_file_saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
