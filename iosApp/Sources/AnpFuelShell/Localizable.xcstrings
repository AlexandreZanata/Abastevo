          "stringUnit": {
            "state": "translated",
            "value": "O lançamento sai deste aparelho. Se já foi enviado, a exclusão gratuita também é enviada à nuvem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina el registro de este dispositivo. Si ya se envió, también se elimina de la nube sin coste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wird von diesem Gerät gelöscht. Bereits hochgeladene Einträge werden auch kostenlos aus der Cloud gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture est supprimée de cet appareil. Les écritures déjà envoyées sont aussi effacées du cloud gratuitement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末から記録を削除します。すでにアップロードした記録はクラウドからも無料で削除します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись будет удалена с этого устройства. Загруженные записи также бесплатно удаляются из облака."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此设备删除记录。已上传的记录也会免费从云端删除。"
          }
        }
      }
    },
