    "help.compare_prices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore official ANP prices and compare them with community reports with photos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore preços oficiais da ANP e compare com relatos com foto da comunidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los precios oficiales de la ANP y compáralos con los informes con fotos de la comunidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke offizielle ANP-Preise und vergleiche sie mit Community-Meldungen mit Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les prix officiels de l’ANP et comparez-les aux signalements de la communauté accompagnés de photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANPの公式価格を調べ、コミュニティからの写真付き報告と比較できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите официальные цены ANP и сравнивайте их с сообщениями сообщества с фотографиями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 ANP 官方价格，并与附有照片的社区报告进行比较。"
          }
        }
      }
    },
