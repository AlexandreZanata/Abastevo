    "explore.faq.offline_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The city list, price drafts, ledger entries and downloaded survey weeks are available on this device. New online prices and route previews need a connection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de cidades, os rascunhos de preço, os lançamentos do diário e as semanas baixadas ficam disponíveis neste aparelho. Novos preços online e prévias de rota precisam de conexão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de ciudades, los borradores de precios, los registros y las semanas descargadas están disponibles en el dispositivo. Los precios nuevos en línea y las vistas previas de rutas requieren conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Städteliste, Preisentwürfe, Fahrtenbucheinträge und heruntergeladene Erhebungswochen sind auf dem Gerät verfügbar. Neue Onlinepreise und Routenvorschauen erfordern eine Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des villes, les brouillons de prix, les écritures du journal et les semaines téléchargées sont disponibles sur l’appareil. Les nouveaux prix en ligne et les aperçus d’itinéraire nécessitent une connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市一覧、価格の下書き、記録、ダウンロードした調査週はこの端末で利用できます。新しいオンライン価格や経路プレビューにはインターネット接続が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список городов, черновики цен, записи журнала и скачанные недели доступны на устройстве. Для новых цен и просмотра маршрутов нужно подключение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上可查看城市列表、价格草稿、台账记录和已下载的调查周。查看新的在线价格和路线预览需要联网。"
          }
        }
      }
    },
