    "onboarding.offline_queue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline contributions queue securely on your device and send when the connection returns."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuições feitas sem internet ficam seguras na fila local e enviam quando a conexão retornar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contribuciones sin conexión se guardan en una cola segura en el dispositivo y se envían al recuperar la conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline erstellte Beiträge bleiben sicher in der Warteschlange und werden bei erneuter Verbindung gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contributions faites hors ligne sont mises en attente sur votre appareil et envoyées au retour de la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン中の投稿は端末の送信待ちに安全に保存され、接続が戻ると送信されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Материалы, созданные без сети, безопасно хранятся в очереди на устройстве и отправляются после подключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线贡献会安全保存在设备队列中，并在恢复连接后发送。"
          }
        }
      }
    },
