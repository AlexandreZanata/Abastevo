    "ledger.refusal.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "data rejected: the vehicle must exist in the cloud, and the odometer reading cannot be lower than one already uploaded"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "dados recusados pelo servidor: o veículo precisa existir na nuvem e o hodômetro não pode ser menor que um já enviado"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "datos rechazados: el vehículo debe estar en la nube y la lectura del odómetro no puede ser inferior a otra ya enviada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten abgelehnt: Das Fahrzeug muss in der Cloud vorhanden sein und der Kilometerstand darf nicht niedriger als ein bereits hochgeladener Stand sein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "données refusées : le véhicule doit exister dans le cloud et le kilométrage ne peut pas être inférieur à une valeur déjà envoyée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが拒否されました。車両がクラウドにあり、走行距離がアップロード済みの値を下回らないことを確認してください"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "данные отклонены: автомобиль должен быть в облаке, а пробег не может быть меньше уже отправленного значения"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据被拒绝：车辆必须存在于云端，且里程表读数不得低于已上传的读数"
