    "onboarding.compare_sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare ANP prices with community reports that include a photo of the station’s price board."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare preços da ANP e relatos da comunidade com foto da placa do posto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara precios de la ANP con informes de la comunidad que incluyen una foto del cartel de precios de la estación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche ANP-Preise mit Community-Meldungen, die ein Foto der Preistafel enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
