    "ledger.sync.erase_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases the account’s server entries for free and revokes consent. Entries remain on this device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga gratuitamente os lançamentos desta conta no servidor e revoga o consentimento. Os registros continuam neste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra gratis del servidor los registros de esta cuenta y retira el consentimiento. Los registros se conservan en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Servereinträge dieses Kontos kostenlos und widerruft die Einwilligung. Die Einträge bleiben auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface gratuitement les écritures du compte sur le serveur et révoque le consentement. Les écritures restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのサーバー上の記録を無料で消去し、同意を取り消します。記録はこの端末に残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно удаляет с сервера записи аккаунта и отзывает согласие. Записи останутся на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费删除此账户的服务器记录并撤回同意。记录仍保存在此设备上。"
          }
        }
      }
    },
