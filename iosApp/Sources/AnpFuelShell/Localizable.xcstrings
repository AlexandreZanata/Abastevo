    "ledger.refuel_calculation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumption uses two consecutive full-tank refuels. The amount paid is the actual total you enter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O consumo usa dois abastecimentos de tanque cheio consecutivos; o valor pago é o total real, sem recalcular pelo preço."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El consumo usa dos repostajes consecutivos con el tanque lleno. El importe pagado es el total real que indicas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verbrauch wird aus zwei aufeinanderfolgenden Volltankungen berechnet. Als gezahlter Betrag gilt der tatsächliche Gesamtbetrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consommation utilise deux pleins complets consécutifs. Le montant payé est le total réel saisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消費量には連続する2回の満タン給油を使用します。支払額には入力した実際の合計を使用します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход рассчитывается по двум последовательным заправкам до полного бака. Оплата — указанная фактическая сумма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能耗根据连续两次加满油箱的记录计算。支付金额采用您填写的实际总额。"
          }
        }
      }
    },
