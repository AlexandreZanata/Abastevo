      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server reported this device as lost or compromised. This company’s data was deleted from the device."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor informou que este aparelho foi perdido ou comprometido. Os dados desta empresa foram apagados deste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor informó de que este dispositivo se perdió o se vio comprometido. Se eliminaron los datos de esta empresa del dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat dieses Gerät als verloren oder kompromittiert gemeldet. Die Daten dieses Unternehmens wurden vom Gerät gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a signalé cet appareil comme perdu ou compromis. Les données de cette entreprise ont été supprimées de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから、このデバイスが紛失または侵害されたと通知されました。この企業のデータはデバイスから削除されました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер сообщил о потере или компрометации устройства. Данные этой компании удалены с устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器报告此设备已丢失或受到入侵。此公司的数据已从设备中删除。"
          }
        }
      }
    },
    "enterprise.custody.locked_delivery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your access to this company ended. Unsent records are retained for delivery. New records cannot be saved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso a esta empresa terminou. Registros ainda não enviados continuam guardados e serão oferecidos ao servidor; nenhum registro novo é aceito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso a esta empresa terminó. Los registros sin enviar se conservan para su envío. No se aceptan nuevos registros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugriff auf dieses Unternehmen wurde beendet. Ungesendete Datensätze bleiben für den Versand erhalten. Neue Datensätze können nicht gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès à cette entreprise a pris fin. Les données non envoyées restent disponibles pour l’envoi. Aucun nouvel enregistrement ne peut être créé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この企業へのアクセスは終了しました。未送信の記録は送信用に保持され、新しい記録は作成できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш доступ к компании закрыт. Неотправленные записи сохраняются для доставки. Новые записи создать нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您对此公司的访问权限已终止。未发送的记录将保留以供发送，无法保存新记录。"
          }
        }
      }
    },
