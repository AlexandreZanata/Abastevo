    "profile.guest_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse ANP prices, maps and vehicles offline without an account. Sign in for free to sync and comment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode consultar preços ANP, mapas e veículos offline sem conta. Entre gratuitamente para sincronizar e comentar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta precios de la ANP, mapas y vehículos sin conexión y sin cuenta. Inicia sesión gratis para sincronizar y comentar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh ANP-Preise, Karten und Fahrzeuge offline ohne Konto an. Melde dich kostenlos an, um zu synchronisieren und zu kommentieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les prix de l’ANP, les cartes et les véhicules hors ligne sans compte. Connectez-vous gratuitement pour synchroniser et commenter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなしでANP価格、地図、車両をオフラインで閲覧できます。同期とコメントには無料でサインインしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены ANP, карты и транспорт можно смотреть без сети и без учётной записи. Для синхронизации и комментариев войдите бесплатно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号即可离线查看 ANP 价格、地图和车辆。免费登录后即可同步和发表评论。"
          }
        }
      }
    },
