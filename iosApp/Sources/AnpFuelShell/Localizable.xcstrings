    "android.enterprise_invitation_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The company can see your employee record, the account alias that accepted the invitation, and your activity in this company. Your personal credentials, personal vehicles, private history, and access to other companies stay private."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A empresa verá seu cadastro de funcionário, o apelido da conta que aceitou o convite e suas ações nesta empresa. Ela não verá suas credenciais pessoais, veículos pessoais, histórico privado ou outras empresas às quais você tem acesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La empresa verá tu ficha de empleado, el alias de la cuenta que aceptó la invitación y tus acciones en esta empresa. No verá tus credenciales personales, vehículos personales, historial privado ni otras empresas a las que tengas acceso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Unternehmen sieht Ihren Mitarbeiterdatensatz, den Alias des Kontos, das die Einladung angenommen hat, und Ihre Aktionen innerhalb dieses Unternehmens. Es sieht weder Ihre persönlichen Zugangsdaten, Ihre privaten Fahrzeuge oder Ihren privaten Verlauf noch andere Unternehmen, auf die Sie Zugriff haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entreprise verra votre fiche de salarié, le pseudonyme du compte ayant accepté l’invitation et vos actions au sein de cette entreprise. Elle ne verra ni vos identifiants personnels, ni vos véhicules personnels, ni votre historique privé, ni les autres entreprises auxquelles vous avez accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業は、あなたの従業員情報、招待を承諾したアカウントの別名、この企業内での操作を閲覧できます。個人の認証情報、個人の車両、非公開の履歴、アクセス権を持つ他の企業は閲覧できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организация увидит вашу карточку сотрудника, псевдоним аккаунта, принявшего приглашение, и ваши действия в этой организации. Она не увидит ваши личные учётные данные, личные автомобили, приватную историю или другие организации, к которым у вас есть доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "企业可以查看您的员工档案、接受邀请的账户昵称以及您在该企业内的操作。企业无法查看您的个人凭据、私人车辆、私人历史记录或您加入的其他企业。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_privacy"
    },
