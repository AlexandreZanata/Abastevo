          "stringUnit": {
            "state": "translated",
            "value": "Send this information to Abastevo for private review? The ANP will receive no complaint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar estas informações para revisão privada no Abastevo? Nenhuma denúncia será enviada à ANP."
