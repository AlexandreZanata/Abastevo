    "android.ev_status_insufficient_energy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared battery, reserve and consumption cannot reach the destination under these assumptions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria, a reserva e o consumo declarados não alcançam o destino sob estas hipóteses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería, la reserva y el consumo declarados no alcanzan el destino con estas hipótesis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie, Reserve und Verbrauch reichen unter diesen Annahmen nicht bis zum Ziel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie, la réserve et la consommation déclarées ne permettent pas d’atteindre la destination selon ces hypothèses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宣言したバッテリー・予備・消費電力では、この前提で目的地に到達できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявленных батареи, резерва и расхода недостаточно для достижения цели при этих допущениях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按这些假设，声明的电池、预留和能耗无法到达目的地。"
          }
        }
      },
      "comment": "Android resource: ev_status_insufficient_energy"
    },
