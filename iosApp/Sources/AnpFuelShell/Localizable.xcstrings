    "android.privacy_consent_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read the full terms and freely authorize the recording of my optional preference for the stated purpose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Li os termos integrais e autorizo livremente o registro da minha preferência opcional para a finalidade descrita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He leído los términos completos y autorizo libremente el registro de mi preferencia opcional para la finalidad indicada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die vollständigen Bedingungen gelesen und willige freiwillig in die Speicherung meiner optionalen Präferenz für den beschriebenen Zweck ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je confirme avoir lu les conditions intégrales et autorise librement l’enregistrement de ma préférence facultative pour la finalité décrite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規約の全文を読み、記載された目的のために任意の希望を記録することを自由意思で許可します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я прочитал полные условия и добровольно разрешаю запись необязательного предпочтения для указанной цели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读完整条款，自愿授权记录所述目的的可选偏好。"
          }
        }
      },
      "comment": "Android resource: privacy_consent_check"
    },
    "android.privacy_deletion_receipt_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A received request starts deletion; it does not confirm physical deletion of all copies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recebimento da solicitação inicia a exclusão; não confirma a exclusão física de todas as cópias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir la solicitud inicia la eliminación; no confirma la eliminación física de todas las copias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Empfang startet die Löschung; er bestätigt nicht die physische Löschung aller Kopien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réception déclenche la suppression ; elle ne confirme pas la suppression physique de toutes les copies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼の受信は削除の開始を意味し、すべてのコピーの物理的削除を保証するものではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получение запускает удаление; оно не подтверждает физическое удаление всех копий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到请求将启动删除；这不表示所有副本已被物理删除。"
          }
        }
      },
      "comment": "Android resource: privacy_deletion_receipt_note"
    },
