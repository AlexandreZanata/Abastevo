    "ledger.estimate.account_delete_cleanup_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion was requested. The device could not clear its saved efficiency estimates."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão da conta foi solicitada. O dispositivo não conseguiu limpar as estimativas de eficiência salvas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó eliminar la cuenta. El dispositivo no pudo borrar las estimaciones de eficiencia guardadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontolöschung wurde angefordert. Das Gerät konnte seine gespeicherten Effizienzschätzungen nicht löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du compte a été demandée. L’appareil n’a pas pu effacer ses estimations d’efficacité enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除をリクエストしました。この端末の保存済み推定燃費を削除できませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на удаление учётной записи отправлен. Не удалось удалить сохранённые оценки эффективности с устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求删除账户。设备无法清除本地保存的效率估算值。"
          }
        }
      }
    },
