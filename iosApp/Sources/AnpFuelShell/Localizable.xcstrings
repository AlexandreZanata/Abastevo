        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sujet provient d’un utilisateur que vous avez bloqué. Vous pouvez le débloquer dans Profil → Gérer le compte → Utilisateurs bloqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトピックはあなたがブロックしたユーザーのものです。「プロフィール → アカウントを管理 → ブロックしたユーザー」から解除できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема от пользователя, которого вы заблокировали. Разблокировать его можно в разделе «Профиль → Управлять аккаунтом → Заблокированные пользователи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此话题来自你屏蔽的用户。你可以在“个人资料 → 管理账户 → 已屏蔽的用户”中解除屏蔽。"
