    "android.privacy_request_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service could not confirm the decision. Retry later; no success is assumed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço não confirmou a decisão. Tente depois; não se presume sucesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio no confirmó la decisión. Inténtelo más tarde; no se presume éxito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst konnte die Entscheidung nicht bestätigen. Später erneut versuchen; kein Erfolg wird angenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service ne confirme pas la décision. Réessayez plus tard ; aucun succès présumé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスは決定を確認できませんでした。後で再試行してください。成功したとは見なしません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис не подтвердил решение. Повторите позже; успех не предполагается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务未确认决定。请稍后重试；不会假定成功。"
          }
        }
      },
      "comment": "Android resource: privacy_request_failed"
    },
