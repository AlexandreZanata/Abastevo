    "explore.faq.sources_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ANP prices come from the official weekly survey, published after data collection. Drivers report community prices at the station, with photos and confirmations where available."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços da ANP vêm da pesquisa semanal oficial, publicada depois da coleta. Motoristas enviam os preços da comunidade no posto, com fotos e confirmações quando disponíveis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios de la ANP proceden de la encuesta semanal oficial, que se publica tras la recogida de datos. Los conductores informan de los precios de la comunidad en la estación, con fotos y confirmaciones si están disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ANP-Preise stammen aus der offiziellen Wochenerhebung, die nach der Datenerfassung erscheint. Fahrer melden Community-Preise an der Tankstelle, soweit verfügbar mit Fotos und Bestätigungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix ANP proviennent de l’enquête hebdomadaire officielle, publiée après la collecte. Les conducteurs communiquent les prix de la communauté à la station, avec des photos et des confirmations lorsqu’elles sont disponibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANP価格は、データ収集後に公表される公式の週間調査に基づきます。コミュニティ価格はドライバーが給油所で報告し、利用可能な場合は写真や確認が付きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены ANP взяты из официального еженедельного исследования, опубликованного после сбора данных. Водители сообщают цены сообщества на АЗС, по возможности с фото и подтверждениями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ANP 价格来自数据采集后发布的官方每周调查。社区价格由驾驶者在加油站报告，并在可用时附有照片和确认。"
          }
        }
      }
    },
