    "android.community_vote_dispute_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm affirms the exact amount and condition above. Disputes never amplify votes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar atesta o valor e a condição exatos acima. Contestações nunca ampliam votos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar atestigua el importe y la condición exactos de arriba. Las disputas nunca amplían votos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen bestätigt den exakten Betrag und Zustand oben. Beanstandungen verstärken Stimmen nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer atteste le montant et la condition exacts ci-dessus. Les contestations n'amplifient jamais les votes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認すると上記の正確な金額と条件を証明します。異議申立てで投票が増えることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждение удостоверяет точную сумму и условия выше. Споры никогда не усиливают голоса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认即证明上述确切金额和条件。异议绝不会增加投票权重。"
          }
        }
      },
      "comment": "Android resource: community_vote_dispute_hint"
    },
