    "enterprise.context.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access ended. Unsent records are retained. New records cannot be saved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso encerrado: registros ainda não enviados continuam guardados; nenhum registro novo é aceito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso terminó. Se conservan los registros sin enviar y no se aceptan nuevos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff wurde beendet. Ungesendete Datensätze bleiben erhalten. Neue Einträge können nicht gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès a pris fin. Les données non envoyées sont conservées. Aucun nouvel enregistrement ne peut être créé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスは終了しました。未送信の記録は保持され、新しい記録は作成できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ закрыт. Неотправленные записи сохраняются. Создавать новые записи нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限已终止。未发送的记录会保留，无法保存新记录。"
          }
        }
      }
    },
    "enterprise.context.origin_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas requires a published HTTPS server. Company mode is unavailable in this network environment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Abastevo Empresas exige um servidor HTTPS publicado. Este ambiente de rede não oferece o modo empresa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas requiere un servidor HTTPS publicado. El modo empresa no está disponible en este entorno de red."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas benötigt einen veröffentlichten HTTPS-Server. In dieser Netzwerkumgebung ist der Unternehmensmodus nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas nécessite un serveur HTTPS publié. Le mode entreprise est indisponible dans cet environnement réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas には公開 HTTPS サーバーが必要です。このネットワーク環境では企業モードを利用できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Abastevo Empresas нужен опубликованный HTTPS-сервер. Режим компании недоступен в этой сетевой среде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Abastevo Empresas 需要已发布的 HTTPS 服务器。当前网络环境不支持公司模式。"
          }
        }
      }
    },
    "enterprise.context.partition_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company records stay separate from your personal data and are signed with this device’s key when sent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros da empresa ficam separados dos seus dados pessoais e são enviados assinados pela chave deste aparelho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de la empresa se mantienen separados de tus datos personales y se firman con la clave de este dispositivo al enviarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unternehmensdaten bleiben von deinen persönlichen Daten getrennt und werden beim Senden mit dem Schlüssel dieses Geräts signiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de l’entreprise restent séparées de vos données personnelles et sont signées avec la clé de cet appareil lors de l’envoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業の記録は個人データと分離され、このデバイスのキーで署名して送信されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные компании хранятся отдельно от личных данных и подписываются ключом этого устройства при отправке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公司记录与个人数据分开存储，发送时使用此设备的密钥签名。"
          }
        }
      }
    },
    "enterprise.context.selection_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting a company requires online confirmation. Records stay with the company where they were created when you switch workspaces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção de empresa exige confirmação online. Os registros continuam na empresa em que foram criados ao trocar de espaço."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de empresa requiere confirmación en línea. Al cambiar de espacio, los registros quedan en la empresa donde se crearon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl eines Unternehmens muss online bestätigt werden. Beim Wechsel bleiben die Datensätze beim Unternehmen, in dem sie erstellt wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection d’une entreprise doit être confirmée en ligne. Lors d’un changement d’espace, les données restent dans l’entreprise où elles ont été créées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業の選択にはオンライン確認が必要です。スペースを切り替えても、記録は作成した企業に残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор компании требует подтверждения через интернет. При смене пространства записи остаются в компании, где они созданы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择公司需要在线确认。切换工作空间后，记录仍保留在其创建时所属的公司。"
          }
        }
      }
    },
