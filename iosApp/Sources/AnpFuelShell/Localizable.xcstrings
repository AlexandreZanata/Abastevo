    "ev.trip.assumptions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This estimate excludes traffic, elevation and live charger availability. Follow road and charging conditions when you travel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa não inclui trânsito, relevo nem disponibilidade em tempo real. Observe as condições da estrada e de recarga durante a viagem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estimación excluye tráfico, desnivel y disponibilidad en tiempo real. Revisa las condiciones de circulación y recarga al viajar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schätzwert berücksichtigt keinen Verkehr, keine Steigungen und keine Live-Verfügbarkeit. Beachte unterwegs die Straßen- und Ladebedingungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estimation exclut le trafic, le relief et la disponibilité en temps réel. Tenez compte des conditions de circulation et de recharge pendant le trajet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この見積もりには交通、標高、充電器のリアルタイム空き状況は含まれません。旅行中は実際の道路と充電状況を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка не учитывает пробки, рельеф и доступность зарядок в реальном времени. В поездке следите за дорожными условиями и доступностью зарядок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此估算未考虑交通、海拔和充电设备的实时可用性。出行时请查看实际道路和充电条件。"
          }
        }
      }
    },
