            "value": "Sair e limpar dados locais privados"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión y borrar los datos privados locales"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden und private lokale Daten löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter et effacer les données privées locales"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトして端末上の非公開データを消去"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти и удалить локальные личные данные"
