          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANPの価格と、給油所の価格表示板の写真付きコミュニティ報告を比較できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
