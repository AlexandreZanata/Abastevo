    "android.enterprise_expenses_capture_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the values: reais with up to two decimals and no thousands separator, and the company amount cannot exceed the total paid. Nothing was saved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira os valores: reais com até duas casas decimais e sem separador de milhar, e o valor da empresa não pode passar do valor pago. Nada foi salvo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los valores: reales con hasta dos decimales y sin separador de miles, y el importe de la empresa no puede superar el total pagado. No se guardó nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Werte: Reais mit höchstens zwei Dezimalstellen und ohne Tausendertrennzeichen; der Betrag für das Unternehmen darf den bezahlten Betrag nicht übersteigen. Nichts wurde gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les valeurs : des reais avec au plus deux décimales et sans séparateur de milliers, et le montant de l’entreprise ne peut pas dépasser le total payé. Rien n’a été enregistré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を確認してください：レアルは小数点以下2桁まで、桁区切りなし。会社負担額は支払総額を超えられません。何も保存されませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте значения: реалы не более чем с двумя знаками после запятой и без разделителя тысяч; сумма для компании не может превышать оплаченную. Ничего не сохранено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查数值：雷亚尔最多两位小数且不带千位分隔符，公司承担金额不能超过实付总额。没有保存任何内容。"
          }
        }
      },
      "comment": "Android resource: enterprise_expenses_capture_invalid"
    },
