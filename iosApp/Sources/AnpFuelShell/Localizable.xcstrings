        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が拒否されました（%1$@）。圧縮後 256 KiB 以下の JPEG、HEIC、PNG 画像を使用してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
