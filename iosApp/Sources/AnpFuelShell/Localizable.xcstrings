    "android.privacy_terms_language": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full document in Brazilian Portuguese. Available offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Documento integral em português do Brasil. Disponível offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documento completo en portugués de Brasil. Disponible sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständiges Dokument auf brasilianischem Portugiesisch. Offline verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Document intégral en portugais du Brésil. Disponible hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全文はブラジル・ポルトガル語です。オフラインでも読めます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный документ на бразильском португальском. Доступен офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整文件为巴西葡萄牙语。可离线阅读。"
          }
        }
      },
      "comment": "Android resource: privacy_terms_language"
    },
    "android.privacy_terms_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document could not be loaded. Authorization is unavailable; you can still revoke or request your rights."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o documento. A autorização está indisponível; você ainda pode revogar ou exercer seus direitos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el documento. La autorización no está disponible; puede revocar o ejercer sus derechos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument konnte nicht geladen werden. Keine Einwilligung möglich; Widerruf und Ihre Rechte bleiben verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document ne peut pas être chargé. Aucune autorisation possible ; la révocation et vos droits restent accessibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書を読み込めません。同意はできませんが、撤回や権利の行使は可能です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ не загружен. Согласие недоступно; отзыв и ваши права остаются доступны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载文件。不能授权；仍可撤回或行使您的权利。"
          }
        }
      },
      "comment": "Android resource: privacy_terms_unavailable"
    },
    "android.privacy_training_optional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Your free account, price searches and community participation do not depend on this choice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Sua conta gratuita, as consultas de preços e a participação na comunidade não dependem desta escolha."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. La cuenta gratuita, las consultas y la participación no dependen de esta opción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillig. Kostenloses Konto, Preissuche und Teilnahme hängen nicht davon ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Le compte gratuit, les recherches et la participation ne dépendent pas de ce choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。無料アカウント、価格検索、コミュニティへの参加に影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Бесплатная учётная запись, поиск и участие не зависят от этого выбора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。免费账户、价格查询和社区参与不取决于此选择。"
          }
        }
      },
      "comment": "Android resource: privacy_training_optional"
    },
    "android.privacy_training_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training image collection is disabled. This choice records a preference; activating collection will require new terms and fresh consent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A coleta de imagens para treinamento está desativada. Esta escolha registra uma preferência; ativar a coleta exigirá novos termos e nova autorização."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recopilación de imágenes para entrenamiento está desactivada. Esta opción registra una preferencia; activarla exigirá nuevos términos y una nueva autorización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung von Trainingsbildern ist deaktiviert. Diese Auswahl speichert eine Präferenz; die Aktivierung erfordert neue Bedingungen und eine neue Einwilligung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte pour entraînement est désactivée. Ce choix enregistre une préférence ; son activation exigera de nouvelles conditions et un nouveau consentement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習用画像の収集は停止中です。この選択は希望を記録するものです。収集の開始には新しい規約と再同意が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор изображений для обучения отключён. Выбор сохраняет предпочтение; включение потребует новых условий и нового согласия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练图片收集已停用。此选择仅记录偏好；启用收集需要新的条款和重新同意。"
          }
        }
      },
      "comment": "Android resource: privacy_training_unavailable"
    },
