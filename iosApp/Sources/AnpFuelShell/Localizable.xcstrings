    "android.quality_reports_empty_how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report concerns a station and a fuel. Open the station page, choose View quality analyses, then Report an experience or view my reports."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um relato é sempre sobre um posto e um combustível. Abra a página do posto, toque em \"Consultar análises de qualidade\" e depois em \"Relatar experiência ou consultar meus relatos\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relato siempre es sobre una estación y un combustible. Abre la página de la estación, toca \"Consultar análisis de calidad\" y luego \"Relatar experiencia o consultar mis relatos\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meldung bezieht sich immer auf eine Tankstelle und einen Kraftstoff. Öffnen Sie die Seite der Tankstelle, tippen Sie auf \"Qualitätsanalysen ansehen\" und dann auf \"Erfahrung melden oder eigene Meldungen ansehen\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un témoignage concerne toujours une station et un carburant. Ouvrez la page de la station, touchez \"Consulter les analyses de qualité\" puis \"Témoigner ou consulter mes témoignages\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告は必ず1つのスタンドと1つの燃料に関するものです。スタンドのページを開き、「品質検査を見る」、続いて「体験を報告・自分の報告を確認」をタップしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение всегда относится к одной АЗС и одному виду топлива. Откройте страницу АЗС, нажмите \"Посмотреть анализы качества\", затем \"Сообщить об опыте или посмотреть свои сообщения\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条反馈都针对一个加油站和一种燃料。打开加油站页面,点击“查看质量检测”,然后点击“反馈体验或查看我的反馈”。"
          }
        }
      }
    },
