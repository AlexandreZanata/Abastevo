    "vehicle.session_changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account or server changed. Reopen the vehicle to edit it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta ou servidor mudou. Abra o veículo novamente para editar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaron tu cuenta o servidor. Vuelve a abrir el vehículo para editarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto oder Server hat sich geändert. Öffne das Fahrzeug erneut zum Bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte ou votre serveur a changé. Rouvrez le véhicule pour le modifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントまたはサーバーが変わりました。編集するには車両を開き直してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт или сервер изменился. Откройте автомобиль снова для редактирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或服务器已更改。请重新打开车辆进行编辑。"
          }
        }
      }
    },
    "vehicle.storage_unavailable": {
