    "android.quality_reports_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports record your personal account. They do not verify a purchase or provide a lab result or official finding. Leave out other people’s personal information."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relato é uma declaração pessoal. Não é laudo, compra verificada ou resultado oficial. Não inclua dados pessoais de terceiros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su relato es una declaración personal. No es un análisis, una compra verificada ni un resultado oficial. No incluya datos personales de terceros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Meldung ist eine persönliche Aussage. Sie ist weder Laborbefund noch verifizierter Kauf oder amtliches Ergebnis. Keine personenbezogenen Daten Dritter angeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre témoignage est une déclaration personnelle. Ce n’est ni une analyse, ni un achat vérifié, ni un résultat officiel. N’incluez pas les données personnelles de tiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは個人の申告です。検査結果、購入確認、公式結果ではありません。第三者の個人情報を含めないでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это личное заявление, а не лабораторный анализ, подтверждённая покупка или официальный результат. Не указывайте персональные данные других людей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是个人陈述，不是检测报告、已验证购买或官方结果。请勿填写他人的个人信息。"
          }
        }
      }
    },
