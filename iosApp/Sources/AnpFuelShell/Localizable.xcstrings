        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago nunca afecta la confianza ni la posición de las estaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen wirken sich nicht auf das Vertrauen oder die Rangfolge von Tankstellen aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements n’affectent jamais la confiance ni le classement des stations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いが信頼性や給油所の順位に影響を与えることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата не влияет на доверие или рейтинг АЗС."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款不会影响信任度或加油站排名。"
          }
        }
      }
    },
