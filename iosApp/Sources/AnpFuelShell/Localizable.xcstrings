    "android.safety_report_user_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why are you reporting this user? Reports are private and reviewed by moderation. The content stays visible until review."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que você está denunciando este usuário? A denúncia é privada e analisada pela moderação. O conteúdo continua visível até a análise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué denuncias a este usuario? Las denuncias son privadas y las revisa la moderación. El contenido sigue visible hasta la revisión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum meldest du diesen Nutzer? Meldungen sind privat und werden von der Moderation geprüft. Der Inhalt bleibt bis zur Prüfung sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi signalez-vous cet utilisateur ? Les signalements sont privés et examinés par la modération. Le contenu reste visible jusqu’à l’examen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザーを報告する理由を選んでください。報告は非公開で、モデレーターが確認します。確認が終わるまでコンテンツは表示されたままです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему вы жалуетесь на этого пользователя? Жалобы конфиденциальны и проверяются модерацией. До проверки контент остаётся видимым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你为什么要举报此用户？举报内容保密，并由审核团队处理。审核完成前内容仍会显示。"
          }
        }
      },
      "comment": "Android resource: safety_report_user_prompt"
    },
    "android.safety_report_user_received": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report received. The moderation team will review it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Denúncia recebida. A equipe de moderação vai analisar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Denuncia recibida. El equipo de moderación la revisará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldung erhalten. Das Moderationsteam prüft sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalement reçu. L’équipe de modération va l’examiner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告を受け付けました。モデレーターが確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба получена. Команда модерации её рассмотрит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到举报，审核团队会进行处理。"
          }
        }
      },
      "comment": "Android resource: safety_report_user_received"
    },
    "android.safety_report_user_replayed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already reported this user. The report is under review."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
