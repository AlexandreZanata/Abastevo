    "ledger.migrated_review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry migrated from an earlier version. Check the date, time, fuel, fill type, and odometer, then save to finish your review. It will sync only after review."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro migrado da versão anterior: confira data e hora, combustível, tipo de enchimento e hodômetro, e salve para concluir a revisão. Até lá ele não é sincronizado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro migrado de una versión anterior. Comprueba la fecha, la hora, el combustible, el tipo de llenado y el odómetro y guarda para terminar la revisión. Hasta entonces no se sincroniza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag aus einer früheren Version. Prüfe Datum, Uhrzeit, Kraftstoff, Füllart und Kilometerstand. Speichere, um die Prüfung abzuschließen. Erst danach wird synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écriture migrée d’une ancienne version. Vérifiez la date, l’heure, le carburant, le type de plein et le compteur, puis enregistrez. La synchronisation attend votre vérification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のバージョンから移行した記録です。日時、燃料、給油の種類、走行距離を確認して保存してください。確認が済むまで同期されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись перенесена из прежней версии. Проверьте дату, время, топливо, тип заправки и пробег, затем сохраните. До проверки запись не синхронизируется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录从旧版本迁移而来。请检查日期、时间、燃料、加注类型和里程表读数，然后保存。核实后才会同步。"
          }
        }
      }
    },
