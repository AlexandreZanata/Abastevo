    "anp.week.verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official files come from gov.br/anp. The app verifies size, SHA-256 and spreadsheet contents and excludes the files from backups. Station prices are limited to the selected city’s state."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos oficiais vêm de gov.br/anp. O app verifica o tamanho, o SHA-256 e o conteúdo da planilha e deixa os arquivos fora do backup. Os preços por posto ficam restritos ao estado da cidade escolhida."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos oficiales proceden de gov.br/anp. La app verifica el tamaño, el SHA-256 y el contenido antes de guardarlos fuera de la copia de seguridad. Los precios por estación se limitan al estado de la ciudad elegida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offiziellen Dateien stammen von gov.br/anp. Die App prüft Größe, SHA-256 und Tabelleninhalt und schließt die Dateien von Backups aus. Tankstellenpreise sind auf den Bundesstaat der ausgewählten Stadt begrenzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers officiels proviennent de gov.br/anp. L’app vérifie leur taille, leur SHA-256 et le contenu du tableur, et les exclut des sauvegardes. Les prix par station se limitent à l’État de la ville choisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式ファイルはgov.br/anpから取得します。アプリはサイズ、SHA-256、表の内容を検証し、バックアップの対象外にします。給油所別価格は選択した都市の州内に限ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Официальные файлы получены с gov.br/anp. Приложение проверяет размер, SHA-256 и содержимое таблицы. Файлы не входят в резервные копии. Цены по АЗС доступны только для штата выбранного города."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方文件来自 gov.br/anp。应用会验证文件大小、SHA-256 和电子表格内容，并将文件排除在备份之外。各加油站的价格仅限所选城市所在的州。"
          }
        }
      }
    },
