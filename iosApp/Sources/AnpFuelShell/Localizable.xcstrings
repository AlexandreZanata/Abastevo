    "android.safety_topic_hidden_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This topic is from a user you blocked. You can unblock them in Profile → Manage account → Blocked users."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tópico é de um usuário que você bloqueou. Você pode desbloquear em Perfil → Gerenciar conta → Usuários bloqueados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema es de un usuario que bloqueaste. Puedes desbloquearlo en Perfil → Gestionar cuenta → Usuarios bloqueados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Thema stammt von einem Nutzer, den du blockiert hast. Du kannst ihn unter Profil → Konto verwalten → Blockierte Nutzer wieder freigeben."
          }
