    "android.station_management_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the fields: services must be selected from the list, description up to 280 characters, other fields up to 256 UTF-8 bytes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira os campos: selecione os serviços da lista, descrição até 280 caracteres e demais campos até 256 bytes UTF-8."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los campos: servicios de la lista, descripción hasta 280 caracteres y otros campos hasta 256 bytes UTF-8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Felder prüfen: Leistungen aus der Liste, Beschreibung bis 280 Zeichen, andere Felder bis 256 UTF-8-Bytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
