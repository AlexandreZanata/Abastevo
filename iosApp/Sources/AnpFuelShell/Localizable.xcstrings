    "map.offline.station_instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When offline, select a station in abastevo and tap Open in Apple Maps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem internet, escolha um posto no abastevo e toque em Abrir no Apple Maps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión, elige una estación en abastevo y toca Abrir en Apple Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle offline eine Tankstelle in abastevo und tippe auf In Apple Karten öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne, choisissez une station dans abastevo et touchez Ouvrir dans Apple Plans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン時はabastevoで給油所を選び、「Appleマップで開く」をタップします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без интернета выберите АЗС в abastevo и нажмите «Открыть в Картах Apple»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线时，在 abastevo 中选择一个加油站并轻点“在 Apple 地图中打开”。"
          }
        }
      }
