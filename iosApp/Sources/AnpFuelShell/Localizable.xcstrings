    "android.vehicle_premium_required_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first vehicle is free. A second or third vehicle needs the Premium vehicles capability. Your vehicles and data are preserved."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu primeiro veículo é grátis. O segundo ou terceiro veículo precisa da capacidade de veículos do Premium. Seus veículos e dados estão preservados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su primer vehículo es gratis. El segundo o tercer vehículo necesita la capacidad de vehículos de Premium. Sus vehículos y datos se conservan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr erstes Fahrzeug ist kostenlos. Für ein zweites oder drittes Fahrzeug ist die Premium-Fahrzeugfunktion erforderlich. Ihre Fahrzeuge und Daten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier véhicule est gratuit. Un deuxième ou troisième véhicule nécessite la capacité véhicules de Premium. Vos véhicules et données sont préservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の車両は無料です。2台目または3台目の車両にはPremiumの車両機能が必要です。車両とデータは保持されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый автомобиль бесплатен. Для второго или третьего нужна возможность Premium для автомобилей. Ваши автомобили и данные сохранены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的第一辆车免费。第二或第三辆车需要 Premium 车辆功能。您的车辆和数据将保留。"
          }
        }
      },
      "comment": "Android resource: vehicle_premium_required_message"
    },
    "android.vehicle_price_drop_alert_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a local notification after each weekly import when your tracked price drops."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba uma notificação local após cada importação semanal quando o preço acompanhado cair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reciba una notificación local tras cada importación semanal cuando baje el precio que sigue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie nach jedem wöchentlichen Import eine lokale Benachrichtigung, wenn der verfolgte Preis sinkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification locale après chaque import hebdomadaire lorsque le prix suivi baisse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡中の価格が下がったとき、週次インポート後にローカル通知を受け取ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте локальное уведомление после каждого еженедельного импорта, когда отслеживаемая цена снижается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次每周导入后，当跟踪的价格下降时接收本地通知。"
          }
        }
      },
      "comment": "Android resource: vehicle_price_drop_alert_description"
    },
