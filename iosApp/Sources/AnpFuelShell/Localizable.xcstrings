    "map.offline.apple_maps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Maps, tap your picture or initials, then Offline Maps and Download New Map."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Apple Maps, toque na sua foto ou iniciais, depois em Mapas Offline e Baixar Novo Mapa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Apple Maps, toca tu foto o iniciales y luego Mapas sin conexión y Descargar nuevo mapa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in Apple Karten auf dein Bild oder deine Initialen und dann auf Offlinekarten und Neue Karte laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Apple Plans, touchez votre photo ou vos initiales, puis Plans hors ligne et Télécharger un nouveau plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleマップで写真またはイニシャルをタップし、「オフラインマップ」、「新しいマップをダウンロード」の順に選びます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Картах Apple нажмите на фото или инициалы, затем выберите «Офлайн-карты» и «Загрузить новую карту»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 地图中轻点头像或姓名首字母，然后选择“离线地图”和“下载新地图”。"
          }
        }
      }
    },
    "map.offline.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn-by-turn navigation without internet uses Apple Maps offline maps (iOS 17 or later). Download your region once and open routes from abastevo in Apple Maps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone, a navegação curva a curva sem internet usa os mapas offline do Apple Maps (iOS 17 ou posterior). Baixe a sua região uma vez e abra as rotas do abastevo no Apple Maps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La navegación paso a paso sin internet usa los mapas sin conexión de Apple Maps (iOS 17 o posterior). Descarga tu región una vez y abre las rutas de abastevo en Apple Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Navigation ohne Internet nutzt die Offlinekarten von Apple Karten (ab iOS 17). Lade deine Region einmal herunter und öffne Routen aus abastevo in Apple Karten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guidage sans Internet utilise les plans hors ligne d’Apple Plans (iOS 17 ou ultérieur). Téléchargez votre région une fois et ouvrez les itinéraires d’abastevo dans Apple Plans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット接続がないときのターンバイターン案内には、Appleマップのオフラインマップ（iOS 17以降）を使用します。対象地域を一度ダウンロードし、abastevoの経路をAppleマップで開いてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошаговая навигация без интернета использует офлайн-карты Apple (iOS 17 или новее). Скачайте свой регион и открывайте маршруты abastevo в Картах Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无网络时的逐向导航使用 Apple 地图的离线地图（iOS 17 或更高版本）。下载一次所在区域，然后在 Apple 地图中打开 abastevo 的路线。"
          }
        }
      }
    },
    "map.offline.download_area": {
