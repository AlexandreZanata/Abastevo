    "android.station_claim_received": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server received the proof. This does not approve representation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recebeu a prova. Isso não aprova a representação."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor recibió la prueba. Esto no aprueba la representación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server hat den Nachweis empfangen. Vertretung ist damit nicht genehmigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a reçu la preuve. Cela n’approuve pas la représentation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが証拠を受信しました。代表権の承認ではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер получил доказательство. Это не одобряет представительство."
