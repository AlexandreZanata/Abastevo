    "ledger.sync.paused_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads paused: the server requires Premium (professional.write) or consent. Your entries remain here, and deleting is still free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envios pausados: o servidor exige o Premium (professional.write) ou o consentimento. Os registros continuam aqui, e exclusões seguem gratuitas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíos en pausa: el servidor requiere Premium (professional.write) o consentimiento. Los registros se conservan aquí y eliminarlos sigue siendo gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads pausiert: Der Server verlangt Premium (professional.write) oder eine Einwilligung. Die Einträge bleiben hier und das Löschen ist weiterhin kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envois suspendus : le serveur exige Premium (professional.write) ou votre consentement. Vos écritures restent ici et la suppression est gratuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード一時停止：サーバーにはプレミアム（professional.write）または同意が必要です。記録はこの端末に残り、削除は引き続き無料です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка приостановлена: сервер требует Premium (professional.write) или согласие. Записи останутся здесь, а удаление по-прежнему бесплатно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传已暂停：服务器要求 Premium（professional.write）或同意。记录仍保存在此设备上，删除仍然免费。"
          }
        }
      }
    },
