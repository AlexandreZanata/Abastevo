    "android.quality_reports_anp_handoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll open the official ANP website. You can choose to submit a complaint there. Abastevo will not send your report."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você abrirá o site oficial da ANP. O Abastevo não enviará seu relato. Você decide se deseja registrar uma manifestação lá."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrirá el sitio oficial de la ANP. Abastevo no enviará su relato. Usted decide si desea presentar una comunicación allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offizielle ANP-Seite wird geöffnet. Abastevo übermittelt Ihre Meldung nicht. Sie entscheiden, ob Sie dort eine Mitteilung einreichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site officiel de l’ANP va s’ouvrir. Abastevo ne transmettra pas votre témoignage. Vous décidez si vous souhaitez y déposer une demande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANPの公式サイトを開きます。Abastevoは報告を送信しません。そこで申立てを行うかはご自身で決められます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется официальный сайт ANP. Abastevo не отправит ваше сообщение. Вы сами решаете, обращаться ли туда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将打开ANP官方网站。Abastevo不会发送您的反馈。您可自行决定是否在那里提交意见。"
          }
        }
      }
    },
