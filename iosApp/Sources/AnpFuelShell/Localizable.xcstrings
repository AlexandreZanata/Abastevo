        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar estos datos para revisión privada en Abastevo? No se enviará ninguna denuncia a la ANP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben zur privaten Prüfung an Abastevo senden? Es wird keine Beschwerde an die ANP gesendet."
