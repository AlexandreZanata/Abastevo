    "identity.apple_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not request your name or email from Apple. Signing in links this device key to your free account for posting."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome e e-mail não são solicitados à Apple. Ao entrar, a chave deste aparelho é vinculada à sua conta gratuita para publicar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No solicitamos tu nombre ni tu correo a Apple. Al iniciar sesión, la clave de este dispositivo se vincula a tu cuenta gratuita para publicar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fragen bei Apple weder deinen Namen noch deine E-Mail-Adresse ab. Bei der Anmeldung wird der Geräteschlüssel zum Veröffentlichen mit deinem kostenlosen Konto verknüpft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne demandons ni votre nom ni votre e-mail à Apple. La connexion associe la clé de cet appareil à votre compte gratuit pour publier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleに名前やメールアドレスは要求しません。サインインすると、投稿用に端末のキーが無料アカウントに関連付けられます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не запрашиваем у Apple ваше имя или почту. При входе ключ устройства привязывается к бесплатной учётной записи для публикаций."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不会向 Apple 请求姓名或电子邮件。登录后，此设备的密钥会关联到免费账号，以便发布内容。"
          }
        }
      }
    },
