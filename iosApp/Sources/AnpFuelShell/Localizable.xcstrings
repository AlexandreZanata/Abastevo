    "onboarding.photo_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted photos expire on this device after 24 hours and are excluded from cloud backups."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos enviadas expiram localmente em 24 horas e nunca vão para backup em nuvem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos enviadas caducan en este dispositivo a las 24 horas y quedan fuera de las copias en la nube."
          }
        },
        "de": {
          "stringUnit": {
