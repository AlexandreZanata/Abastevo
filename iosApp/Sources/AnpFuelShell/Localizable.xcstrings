            "state": "translated",
            "value": "Name, address, location, operator, prices and community ratings are outside this management scope."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome, endereço, localização, operador, preços e avaliações da comunidade estão fora deste escopo de gestão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
