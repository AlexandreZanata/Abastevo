    "android.safety_block_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User blocked. Their content is now hidden for you."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuário bloqueado. O conteúdo dessa pessoa agora está oculto para você."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario bloqueado. Su contenido ahora está oculto para ti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzer blockiert. Seine Inhalte sind jetzt für dich ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateur bloqué. Son contenu est désormais masqué pour vous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーをブロックしました。このユーザーのコンテンツは非表示になりました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователь заблокирован. Его контент теперь скрыт для вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽该用户，其内容现已对你隐藏。"
          }
        }
      },
      "comment": "Android resource: safety_block_done"
    },
    "android.safety_block_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their forum topics, comments and replies and their station comments will be hidden for you. They will not be notified and others still see their content. You can unblock them in Profile → Manage account → Blocked users."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tópicos, comentários e respostas dessa pessoa no fórum e os comentários dela em postos ficarão ocultos para você. Ela não será avisada e as outras pessoas continuam vendo o conteúdo. Você pode desbloquear em Perfil → Gerenciar conta → Usuários bloqueados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus temas, comentarios y respuestas en el foro y sus comentarios en estaciones quedarán ocultos para ti. No recibirá ningún aviso y los demás seguirán viendo su contenido. Puedes desbloquearlo en Perfil → Gestionar cuenta → Usuarios bloqueados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Themen, Kommentare und Antworten im Forum sowie seine Tankstellen-Kommentare werden für dich ausgeblendet. Er wird nicht benachrichtigt und andere sehen seine Inhalte weiterhin. Du kannst ihn unter Profil → Konto verwalten → Blockierte Nutzer wieder freigeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses sujets, commentaires et réponses sur le forum ainsi que ses commentaires sur les stations seront masqués pour vous. Il ne sera pas averti et les autres verront toujours son contenu. Vous pouvez le débloquer dans Profil → Gérer le compte → Utilisateurs bloqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザーのフォーラムのトピック、コメント、返信、およびスタンドへのコメントが非表示になります。相手には通知されず、ほかの人には引き続き表示されます。「プロフィール → アカウントを管理 → ブロックしたユーザー」からいつでも解除できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его темы, комментарии и ответы на форуме, а также комментарии к заправкам будут скрыты для вас. Он не получит уведомления, а другие по-прежнему будут видеть его контент. Разблокировать можно в разделе «Профиль → Управлять аккаунтом → Заблокированные пользователи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该用户在论坛中的话题、评论和回复以及对加油站的评论将对你隐藏。对方不会收到通知，其他人仍可看到其内容。你可以在“个人资料 → 管理账户 → 已屏蔽的用户”中解除屏蔽。"
          }
        }
      },
      "comment": "Android resource: safety_block_message"
    },
    "android.safety_block_title": {
