      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Representation is separate from fuel quality, prices and community ratings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A representação é independente da qualidade do combustível, dos preços e das avaliações da comunidade."
          }
