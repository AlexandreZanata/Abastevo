    "map.route.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not calculate the route. If you downloaded the region in Apple Maps, tap Open in Apple Maps to navigate offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível calcular a rota. Se você baixou a região no Apple Maps, toque em Abrir no Apple Maps para navegar sem internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo calcular la ruta. Si descargaste la región en Apple Maps, toca Abrir en Apple Maps para navegar sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route konnte nicht berechnet werden. Wenn du die Region in Apple Karten geladen hast, tippe auf In Apple Karten öffnen, um offline zu navigieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de calculer l’itinéraire. Si vous avez téléchargé la région dans Apple Plans, touchez Ouvrir dans Apple Plans pour naviguer hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路を計算できませんでした。Appleマップで対象地域をダウンロード済みなら、「Appleマップで開く」をタップしてオフラインで案内できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось рассчитать маршрут. Если регион скачан в Картах Apple, нажмите «Открыть в Картах Apple» для навигации без интернета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法计算路线。如果已在 Apple 地图中下载该区域，请轻点“在 Apple 地图中打开”进行离线导航。"
          }
        }
      }
    },
