        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme dem Beitritt zu diesem Unternehmen und der Freigabe der oben beschriebenen Daten zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
