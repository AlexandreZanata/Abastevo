          "stringUnit": {
            "state": "translated",
            "value": "Des heures identiques autorisent la diffusion toute la journée ou désactivent les heures silencieuses, selon le réglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始と終了が同じ場合、配信は終日可能になり、通知を控える設定では制限なしになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если время начала и конца совпадает, доставка разрешена весь день, а тихие часы отключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起止时间相同时，通知时段为全天，免打扰时段为关闭。"
          }
        }
      }
    },
    "alerts.service_boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server-side evaluation and remote notifications are currently unavailable. You can manage rules and check the server inbox."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A avaliação no servidor e as notificações remotas estão indisponíveis. Você pode gerenciar regras e consultar a caixa de alertas do servidor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La evaluación en el servidor y las notificaciones remotas no están disponibles. Puedes gestionar reglas y consultar la bandeja del servidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die serverseitige Auswertung und Push-Mitteilungen sind derzeit nicht verfügbar. Sie können Regeln verwalten und das Server-Postfach abrufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’évaluation côté serveur et les notifications à distance sont indisponibles. Vous pouvez gérer les règles et consulter la boîte d’alertes du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーでの判定とリモート通知は現在利用できません。ルールの管理とサーバーの受信箱の確認はできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверная проверка и удалённые уведомления сейчас недоступны. Вы можете управлять правилами и просматривать входящие на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法使用服务器端评估和远程通知。你仍可管理规则和查看服务器收件箱。"
          }
        }
      }
    },
