    "community.capture_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device recognition suggests prices. This device signs the submission and queues it while offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OCR sugere os valores no dispositivo. O envio é assinado por este aparelho e aguarda na fila quando você está sem conexão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento en el dispositivo sugiere precios. El dispositivo firma el envío y lo pone en cola mientras está sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texterkennung auf dem Gerät schlägt Preise vor. Das Gerät signiert den Beitrag und stellt ihn offline in die Warteschlange."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance sur l’appareil propose des prix. Cet appareil signe l’envoi et le place en attente hors ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上の文字認識で価格を提案します。端末で送信内容を署名し、オフライン中は送信待ちにします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание на устройстве предлагает цены. Устройство подписывает данные и ставит их в очередь без подключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端文字识别会建议价格。此设备会对提交内容签名，并在离线时将其排入队列。"
          }
        }
      }
    },
