    "onboarding.compare_sources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare ANP prices with community reports that include a photo of the station’s price board."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare preços da ANP e relatos da comunidade com foto da placa do posto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara precios de la ANP con informes de la comunidad que incluyen una foto del cartel de precios de la estación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche ANP-Preise mit Community-Meldungen, die ein Foto der Preistafel enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les prix de l’ANP avec les signalements de la communauté accompagnés d’une photo du panneau des prix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANPの価格と、給油所の価格表示板の写真付きコミュニティ報告を比較できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивайте цены ANP с сообщениями сообщества, к которым приложено фото табло АЗС."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 ANP 价格与附有加油站价格牌照片的社区报告进行比较。"
          }
        }
      }
    },
    "onboarding.free_account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free account includes vehicles, history and a refueling log without intrusive ads."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta gratuita sem anúncios intrusivos, com veículos, histórico e diário de abastecimentos incluídos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta gratuita incluye vehículos, historial y registro de repostajes sin anuncios intrusivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kostenlose Konto umfasst Fahrzeuge, Verlauf und Tankbuch ohne aufdringliche Werbung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte gratuit inclut les véhicules, l’historique et un carnet de ravitaillement sans publicités intrusives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料アカウントには車両管理、履歴、給油記録が含まれ、煩わしい広告はありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатная учётная запись включает транспорт, историю и журнал заправок без навязчивой рекламы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费账号包含车辆、历史记录和加油日志，无侵扰性广告。"
          }
        }
      }
    },
    "onboarding.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For city and proximity checks, GPS runs once on request. Your precise location is never published."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verificação de cidade e proximidade, o GPS é usado uma vez mediante solicitação. Sua localização precisa nunca é publicada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comprobar la ciudad y la cercanía, el GPS se usa una vez cuando lo solicitas. Tu ubicación exacta nunca se publica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Stadt- und Umgebungsprüfungen wird GPS auf Anfrage einmalig genutzt. Dein genauer Standort wird nie veröffentlicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vérifier la ville et la proximité, le GPS est utilisé une fois sur demande. Votre position exacte n’est jamais publiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "都市や近接の確認では、要求時に一度だけGPSを使用します。正確な位置情報が公開されることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для проверки города и близости GPS используется однократно по запросу. Ваше точное местоположение не публикуется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证城市和距离时，仅在你发出请求后使用一次 GPS。你的精确位置不会公开。"
          }
        }
      }
    },
    "onboarding.national_coverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track gasoline, ethanol, diesel, CNG, LPG and electric charging across Brazil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe gasolina, etanol, diesel, GNV, GLP e pontos de recarga elétrica em todo o Brasil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta gasolina, etanol, diésel, GNC, GLP y recarga eléctrica en todo Brasil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Benzin, Ethanol, Diesel, CNG, LPG und Ladestationen in ganz Brasilien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez l’essence, l’éthanol, le diesel, le GNV, le GPL et les bornes électriques partout au Brésil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラジル全土のガソリン、エタノール、ディーゼル、CNG、LPG、EV充電設備を確認できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за ценами на бензин, этанол, дизель, КПГ и СУГ, а также за зарядными станциями по всей Бразилии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看巴西各地的汽油、乙醇、柴油、CNG、LPG 和电动汽车充电点。"
          }
        }
      }
    },
    "onboarding.no_paid_ranking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment never affects trust or station ranking."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ranking pago: pagamento nunca altera confiança ou posição de postos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago nunca afecta la confianza ni la posición de las estaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen wirken sich nicht auf das Vertrauen oder die Rangfolge von Tankstellen aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements n’affectent jamais la confiance ni le classement des stations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いが信頼性や給油所の順位に影響を与えることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата не влияет на доверие или рейтинг АЗС."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款不会影响信任度或加油站排名。"
          }
        }
      }
    },
    "onboarding.official_separate": {
