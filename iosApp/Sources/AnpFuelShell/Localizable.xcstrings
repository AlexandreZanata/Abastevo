    "android.station_claim_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never send private keys, passwords, PFX or P12 files. Signed PDFs only, up to 5 MiB. Review the privacy conditions before submitting."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca envie chaves privadas, senhas ou arquivos PFX/P12. Apenas PDF assinado, até 5 MiB. Consulte as condições de privacidade antes do envio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca envíes claves privadas, contraseñas ni archivos PFX/P12. Solo PDF firmado de hasta 5 MiB. Consulta las condiciones de privacidad antes de enviar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemals private Schlüssel, Passwörter, PFX- oder P12-Dateien senden. Nur signierte PDFs bis 5 MiB. Vor dem Senden die Datenschutzbedingungen lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’envoyez jamais de clés privées, mots de passe ni fichiers PFX/P12. PDF signé uniquement, jusqu’à 5 MiB. Consultez les conditions de confidentialité avant l’envoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵、パスワード、PFX、P12は送信しないでください。署名済みPDFのみ、最大5 MiBです。送信前にプライバシー条件をご確認ください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отправляйте закрытые ключи, пароли, файлы PFX или P12. Только подписанный PDF до 5 МиБ. Перед отправкой прочитайте условия конфиденциальности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿发送私钥、密码或PFX/P12文件。仅接受签名PDF，最大5 MiB。提交前请阅读隐私条件。"
          }
        }
      },
      "comment": "Android resource: station_claim_privacy"
    },
