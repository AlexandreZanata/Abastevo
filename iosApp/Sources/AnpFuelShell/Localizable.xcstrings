    "android.privacy_modal_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the box below and tap accept to record. Closing without accepting records nothing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque a caixa abaixo e toque em aceitar para registrar. Fechar sem aceitar não registra nada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca la casilla de abajo y toca aceptar para registrar. Cerrar sin aceptar no registra nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kästchen unten markieren und auf Akzeptieren tippen, um zu speichern. Schließen ohne Akzeptieren speichert nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez la case ci-dessous et touchez accepter pour enregistrer. Fermer sans accepter n'enregistre rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のチェックを入れて同意をタップすると記録されます。同意せずに閉じると何も記録されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте поле ниже и нажмите «Принять», чтобы сохранить. Закрытие без принятия ничего не сохраняет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选下方复选框并点按接受即可记录。不接受而关闭不会记录任何内容。"
          }
        }
      },
      "comment": "Android resource: privacy_modal_hint"
    },
    "android.privacy_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. No new authorization was sent. You can disable the preference here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão. Nenhuma nova autorização foi enviada. Você pode desativar a preferência aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. No se envió ninguna autorización nueva. Puede desactivar la preferencia aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Keine neue Einwilligung gesendet. Sie können die Präferenz hier deaktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne. Aucune nouvelle autorisation envoyée. Vous pouvez désactiver la préférence ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。新しい同意は送信されていません。ここで設定を無効にできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. Новое согласие не отправлено. Здесь можно отключить предпочтение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线。未发送新的授权。您可在此停用偏好。"
          }
        }
      },
      "comment": "Android resource: privacy_offline"
    },
