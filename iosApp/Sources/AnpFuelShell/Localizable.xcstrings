    "android.enterprise_invitation_confirmation_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access activates after someone responsible at the company confirms it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acesso só será ativado depois da confirmação de um responsável da empresa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acceso solo se activará después de que lo confirme un responsable de la empresa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
