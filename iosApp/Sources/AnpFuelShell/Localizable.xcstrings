    "android.enterprise_invitation_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code sent by the person responsible at your company."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código que o responsável da empresa enviou para você."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código que te envió el responsable de la empresa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Code ein, den Ihnen die verantwortliche Person des Unternehmens gesendet hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code que le responsable de l’entreprise vous a envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業の担当者から受け取ったコードを入力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите код, который вам отправил ответственный сотрудник организации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入企业负责人发送给您的代码。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_intro"
    },
    "android.enterprise_invitation_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is invalid or expired. Ask the person responsible for a new one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código inválido ou expirado. Peça um novo ao responsável."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código no válido o caducado. Pide uno nuevo al responsable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code ungültig oder abgelaufen. Bitten Sie die verantwortliche Person um einen neuen Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code invalide ou expiré. Demandez-en un nouveau au responsable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが無効か、有効期限が切れています。担当者に新しいコードを依頼してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код недействителен или срок его действия истёк. Попросите ответственного сотрудника выдать новый код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码无效或已过期。请向负责人索取新代码。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_invalid"
    },
    "android.enterprise_invitation_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait before trying again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas. Aguarde antes de tentar novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera antes de volver a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warten Sie, bevor Sie es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Patientez avant de réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。しばらく待ってから再度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Подождите перед повторной попыткой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请稍后重试。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_limited"
    },
    "android.enterprise_invitation_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet to review or respond to an invitation. The company confirms decisions online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para consultar ou responder a um convite. Nenhuma decisão será confirmada sem conexão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para consultar o responder a una invitación. No se confirmará ninguna decisión sin conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich mit dem Internet, um eine Einladung anzusehen oder darauf zu antworten. Offline wird keine Entscheidung bestätigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Internet pour consulter une invitation ou y répondre. Aucune décision ne sera confirmée hors connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を確認または回答するには、インターネットに接続してください。オフラインでは回答は確定しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к интернету, чтобы просмотреть приглашение или ответить на него. Без подключения решение не будет подтверждено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接互联网以查看或回复邀请。离线时不会确认任何决定。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_offline"
    },
    "android.enterprise_invitation_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation accepted. Someone responsible at the company still needs to confirm your access."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite aceito. Seu acesso ainda depende da confirmação de um responsável da empresa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación aceptada. Tu acceso aún necesita la confirmación de un responsable de la empresa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung angenommen. Ihr Zugriff muss noch von einer verantwortlichen Person des Unternehmens bestätigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation acceptée. Votre accès nécessite encore la confirmation d’un responsable de l’entreprise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待を承諾しました。アクセス権を有効にするには、企業の担当者による確認が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение принято. Для доступа ещё требуется подтверждение ответственного сотрудника организации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受邀请。您的访问权限仍需企业负责人确认。"
          }
        }
      },
      "comment": "Android resource: enterprise_invitation_pending"
    },
