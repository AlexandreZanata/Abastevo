    "enterprise.tracking_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is off on iOS. The app does not record your route or location during a trip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreamento desligado no iOS: o aplicativo não registra trajeto nem localização durante a viagem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento está desactivado en iOS. La app no registra la ruta ni la ubicación durante el viaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ortung ist unter iOS deaktiviert. Die App zeichnet während der Fahrt weder Strecke noch Standort auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi est désactivé sur iOS. L’app n’enregistre ni le trajet ni la localisation pendant le déplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS では追跡が無効です。走行中の経路や位置情報は記録されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание на iOS отключено. Приложение не записывает маршрут или местоположение во время поездки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 已关闭追踪。应用不会在行程中记录路线或位置。"
          }
        }
      }
    },
    "enterprise.trip.already_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the current trip before starting another one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre a viagem em andamento antes de iniciar outra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza el viaje actual antes de iniciar otro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die laufende Fahrt, bevor du eine neue startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez le trajet en cours avant d’en démarrer un autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい走行を開始する前に、進行中の走行を終了してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую поездку перед началом новой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束当前行程，再开始新行程。"
          }
        }
      }
    },
    "enterprise.trip.device_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trip is saved on this device and signed before sending. iOS does not record the route or location."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A viagem é guardada neste aparelho e enviada assinada. O iOS não registra trajeto nem localização."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viaje se guarda en este dispositivo y se firma antes de enviarlo. iOS no registra la ruta ni la ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrt wird auf diesem Gerät gespeichert und vor dem Senden signiert. iOS zeichnet weder Strecke noch Standort auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trajet est enregistré sur cet appareil et signé avant l’envoi. iOS n’enregistre ni l’itinéraire ni les positions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行記録はこのデバイスに保存され、署名して送信されます。iOS は経路や位置情報を記録しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка хранится на этом устройстве и подписывается при отправке. iOS не записывает маршрут или местоположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程保存在此设备上并在发送前签名。iOS 不记录路线或位置。"
          }
        }
      }
    },
