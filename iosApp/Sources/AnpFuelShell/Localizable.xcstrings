    "account.export.auth_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not verify account or device access."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu verificar o acesso da conta ou do dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo verificar el acceso de la cuenta o del dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte den Konto- oder Gerätezugriff nicht überprüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas pu vérifier l’accès au compte ou à l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーでアカウントまたは端末のアクセスを確認できませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не смог подтвердить доступ для учётной записи или устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法验证账户或设备访问权限。"
          }
        }
      }
    },
