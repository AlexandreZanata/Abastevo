    "driver.shift.invalidEndOdometer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final odometer must be at least the starting reading."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hodômetro final deve ser igual ou maior que o inicial."
          }
