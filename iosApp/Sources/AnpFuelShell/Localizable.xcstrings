          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclaration enregistrée. Signez à l’extérieur avant de revenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申告文を保存しました。外部で署名してから戻ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявление сохранено. Подпишите внешним инструментом и вернитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明已保存，请在外部签名后返回。"
          }
        }
      },
      "comment": "Android resource: station_claim_file_saved"
    },
    "android.station_claim_file_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF unavailable, invalid or above 5 MiB. Select it again; expired document access is not retained."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF indisponível, inválido ou acima de 5 MiB. Selecione novamente; o acesso expirado ao documento não é mantido."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF no disponible, inválido o mayor de 5 MiB. Selecciónalo de nuevo; no se conserva acceso caducado al documento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF nicht verfügbar, ungültig oder über 5 MiB. Erneut wählen; abgelaufener Dokumentzugriff wird nicht behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF indisponible, invalide ou dépassant 5 MiB. Sélectionnez-le à nouveau ; l’accès expiré n’est pas conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFが利用できない、無効、または5 MiBを超えています。再選択してください。期限切れのアクセス権は保持しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF недоступен, неверен или больше 5 MiB. Выберите снова; истёкший доступ к документу не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF不可用、无效或超过5 MiB，请重新选择。过期的文件访问权限不会保留。"
          }
        }
      },
      "comment": "Android resource: station_claim_file_unavailable"
    },
    "android.station_claim_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaration expired or changed, or input invalid. Refresh the request and select the file again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A declaração expirou ou mudou, ou os dados são inválidos. Atualize a solicitação e selecione o arquivo novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La declaración caducó o cambió, o los datos son inválidos. Actualiza la solicitud y selecciona de nuevo el archivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärung abgelaufen oder geändert, oder Eingabe ungültig. Antrag aktualisieren und Datei erneut wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclaration expirée ou modifiée, ou données invalides. Actualisez la demande et choisissez à nouveau le fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "申告文が失効・変更されたか、入力が無効です。申請を更新してファイルを選び直してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявление истекло или изменилось, либо данные неверны. Обновите заявку и выберите файл снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明已过期或更改，或输入无效。请更新申请并重新选择文件。"
          }
        }
      },
      "comment": "Android resource: station_claim_invalid"
    },
