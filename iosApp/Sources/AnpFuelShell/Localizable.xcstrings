    "android.community_helpful_guest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to a free account to vote"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre em uma conta gratuita para votar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en una cuenta gratuita para votar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Abstimmen bei einem kostenlosen Konto anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un compte gratuit pour voter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投票するには無料アカウントにログインしてください"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в бесплатный аккаунт, чтобы голосовать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录免费账户即可投票"
          }
        }
      },
      "comment": "Android resource: community_helpful_guest"
    },
    "android.community_helpful_guest_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Votes need a free account. Repeated votes from your identity are not counted again. Browsing stays anonymous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso ter uma conta gratuita para votar. Votos repetidos da sua identidade não são contados novamente. A consulta continua anônima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una cuenta gratuita para votar. Los votos repetidos de tu identidad no se cuentan de nuevo. La consulta sigue siendo anónima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Abstimmen ist ein kostenloses Konto erforderlich. Wiederholte Stimmen Ihrer Identität werden nicht erneut gezählt. Das Lesen bleibt anonym."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte gratuit est nécessaire pour voter. Les votes répétés de votre identité ne sont pas comptés à nouveau. La consultation reste anonyme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投票には無料アカウントが必要です。同じ識別情報による重複投票は再集計されません。閲覧は引き続き匿名で利用できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосования нужен бесплатный аккаунт. Повторные голоса вашей идентичности не учитываются снова. Просмотр остаётся анонимным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投票需要免费账户。同一身份的重复投票不会重复计票。浏览仍可匿名进行。"
          }
        }
      },
      "comment": "Android resource: community_helpful_guest_body"
    },
