        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer ces informations pour examen privé dans Abastevo ? Aucune plainte ne sera transmise à l’ANP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
