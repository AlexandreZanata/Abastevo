    "android.station_claim_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free account may request scoped representation. Independent review checks the signature and corporate authority. Sending a document grants no access."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta gratuita pode solicitar representação com escopo definido. A análise independente verifica a assinatura e os poderes empresariais. Enviar um documento não concede acesso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta gratuita puede solicitar representación limitada. La revisión independiente verifica firma y poderes empresariales. Enviar documentos no concede acceso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kostenloses Konto kann begrenzte Vertretung beantragen. Unabhängige Prüfung bestätigt Unterschrift und Unternehmensbefugnis. Dokumentversand gewährt keinen Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte gratuit peut demander une représentation limitée. Un examen indépendant vérifie la signature et les pouvoirs dans l’entreprise. Envoyer un document ne donne aucun accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料アカウントで範囲を限定した代表権を申請できます。独立審査で署名と企業の権限を検証します。書類の送信だけではアクセス権は付与されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный аккаунт может запросить ограниченное представительство. Независимая проверка подтверждает подпись и корпоративные полномочия. Отправка документа не даёт доступа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费账户可申请限定范围的代表资格。独立审核将验证签名及企业授权。发送文件不会授予访问权限。"
          }
        }
      },
      "comment": "Android resource: station_claim_explanation"
    },
    "android.station_claim_export": {
      "extractionState": "manual",
