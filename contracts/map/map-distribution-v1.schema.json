{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abastevo.com.br/contracts/map/map-distribution-v1.schema.json",
  "title": "Abastevo signed map distribution envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "key_id", "algorithm", "manifest", "manifest_sha256", "signature"],
  "properties": {
    "format": {"const": "abastevo.map-distribution-v1"},
    "version": {"const": 1},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "algorithm": {"const": "Ed25519"},
    "manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "description": "base64url (no padding) of the exact native-map manifest bytes."
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100,
      "description": "base64url (no padding) Ed25519 signature over the raw manifest bytes."
    }
  }
}
