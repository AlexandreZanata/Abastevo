{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abastevo.com.br/contracts/map/native-map-manifest-v1.schema.json",
  "title": "Abastevo native map manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "engine", "generation", "region",
    "packages", "dependencies", "sources", "rights", "generated_at"
  ],
  "properties": {
    "format": {"const": "abastevo.native-map-manifest-v1"},
    "version": {"const": 1},
    "generation": {"type": "string", "minLength": 1, "maxLength": 128},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "upstream_sha", "generator_sha", "format_version"],
      "properties": {
        "name": {"const": "comaps"},
        "upstream_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generator_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "format_version": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bbox", "overview"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_lon_deg", "min_lat_deg", "max_lon_deg", "max_lat_deg"],
          "properties": {
            "min_lon_deg": {"type": "number", "minimum": -180, "maximum": 180},
            "min_lat_deg": {"type": "number", "minimum": -90, "maximum": 90},
            "max_lon_deg": {"type": "number", "minimum": -180, "maximum": 180},
            "max_lat_deg": {"type": "number", "minimum": -90, "maximum": 90}
          }
        },
        "overview": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "role": {"enum": ["REGION", "OVERVIEW", "SEARCH", "ROUTING", "STYLE", "FONT"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(?!/)(?!.*\\.\\.)(?!.* /)(?!.*/ )[A-Za-z0-9._/-]+( [A-Za-z0-9._/-]+)*$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "license", "attribution", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 120},
          "license": {"enum": ["ODbL-1.0", "Apache-2.0", "MIT", "CC-BY-4.0"]},
          "attribution": {"type": "string", "minLength": 1, "maxLength": 500},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "attribution", "commercial", "offline", "redistribution"],
      "properties": {
        "license": {"enum": ["ODbL-1.0", "Apache-2.0", "MIT", "CC-BY-4.0"]},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 500},
        "commercial": {"const": true},
        "offline": {"const": true},
        "redistribution": {"const": true}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
