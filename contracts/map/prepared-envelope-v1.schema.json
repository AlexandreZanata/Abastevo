{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abastevo.com.br/contracts/map/prepared-envelope-v1.schema.json",
  "title": "Abastevo prepared map envelope v1",
  "description": "Reuses the charging-prepared-v1 manifest/hash/census discipline. Reference packages, public overlays and private state are separate artifacts, generations and visibility scopes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "product_class", "visibility", "profile_id",
    "profile_sha256", "rights_sha256", "source_revision", "inputs",
    "artifacts", "counts", "content_sha256"
  ],
  "properties": {
    "format": {"const": "abastevo.map-prepared-v1"},
    "version": {"const": 1},
    "product_class": {"enum": ["REFERENCE", "PUBLIC_OVERLAY", "PRIVATE_STATE"]},
    "visibility": {"enum": ["PUBLIC", "PRIVATE"]},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "bytes", "sha256", "roots"],
        "properties": {
          "file": {"type": "string", "minLength": 1, "maxLength": 160},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "roots": {"type": "integer", "minimum": 0}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "records", "sha256"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "required": ["assertions"],
      "properties": {
        "assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "records", "sha256"],
          "properties": {
            "bytes": {"type": "integer", "minimum": 1},
            "records": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "records", "sha256"],
          "properties": {
            "bytes": {"type": "integer", "minimum": 0},
            "records": {"type": "integer", "minimum": 0},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "accepted", "duplicates", "quarantined"],
      "properties": {
        "input": {"type": "integer", "minimum": 1},
        "accepted": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 0}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"product_class": {"const": "PRIVATE_STATE"}}},
      "then": {"properties": {"visibility": {"const": "PRIVATE"}}}
    },
    {
      "if": {"properties": {"visibility": {"const": "PUBLIC"}}},
      "then": {"properties": {"product_class": {"enum": ["REFERENCE", "PUBLIC_OVERLAY"]}}}
    }
  ]
}
